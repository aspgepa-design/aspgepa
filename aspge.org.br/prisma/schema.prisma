generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Associado {
  id                 Int         @id @default(autoincrement())
  nomeCompleto       String
  cpf                String      @unique
  rg                 String?
  expeditor          String?
  matricula          String?
  cargo              String?
  perfil             String      @default("Associado")
  situacao           String?
  sexo               String?
  whatsapp           String?
  email              String?
  senha              String
  dataNascimento     DateTime?
  naturalidade       String?
  estadoCivil        String?
  graduacao          String?
  posGraduacao       String?
  areaAtuacao        String?
  lotacao            String?
  fotoUrl            String?
  fotoCarteirinhaUrl String?
  fotoConfig         String?
  cadastroCompleto   Boolean     @default(false)
  camposPreenchidos  Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  documentos         Documento[]
  logs               Log[]
  gestoes            Gestao[]    @relation("AssociadoToGestao")

  @@map("associados")
}

model Evento {
  id        Int      @id @default(autoincrement())
  data      DateTime
  titulo    String
  local     String?
  horario   String?
  descricao String?
  visivel   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("eventos")
}

model Convenio {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?
  categoria String?
  link      String?
  visivel   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("convenios")
}

model Lancamento {
  id          Int      @id @default(autoincrement())
  data        DateTime
  descricao   String
  valor       Decimal  @db.Decimal(10, 2)
  tipo        String
  responsavel String?
  createdAt   DateTime @default(now())

  @@map("lancamentos")
}

model Votacao {
  id        Int      @id @default(autoincrement())
  titulo    String
  status    String   @default("Aberta")
  dataFim   String?
  votos     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("votacoes")
}

model Gestao {
  id         Int               @id @default(autoincrement())
  ativa      Boolean           @default(false)
  createdAt  DateTime          @default(now())
  fim        DateTime?
  inicio     DateTime?
  nome       String
  membros    DiretoriaGestao[]
  associados Associado[]       @relation("AssociadoToGestao")

  @@map("gestoes")
}

model DiretoriaGestao {
  id       Int    @id @default(autoincrement())
  gestaoId Int
  cpf      String
  nome     String
  cargo    String
  gestao   Gestao @relation(fields: [gestaoId], references: [id], onDelete: Cascade)

  @@map("diretoria_gestao")
}

model Documento {
  id          Int       @id @default(autoincrement())
  nome        String
  path        String
  mimeType    String?
  tamanho     Int?
  associadoId Int
  createdAt   DateTime  @default(now())
  associado   Associado @relation(fields: [associadoId], references: [id], onDelete: Cascade)

  @@map("documentos")
}

model Log {
  id          Int        @id @default(autoincrement())
  acao        String
  detalhes    String?
  associadoId Int?
  ip          String?
  userAgent   String?
  createdAt   DateTime   @default(now())
  associado   Associado? @relation(fields: [associadoId], references: [id])

  @@index([associadoId])
  @@index([createdAt])
  @@map("logs")
}

model ConfigCarteirinha {
  id             Int      @id @default(autoincrement())
  config         String
  templateFrente String?
  templateVerso  String?
  updatedAt      DateTime @updatedAt

  @@map("config_carteirinhas")
}

model SiteConfig {
  id              Int      @id @default(autoincrement())
  sobreTexto      String?
  missao          String?
  visao           String?
  valores         String?
  estatutos       String?
  bannerUrl       String?
  bannerAlt       String?
  mostrarEnquetes Boolean  @default(true)
  mostrarNoticias Boolean  @default(true)
  mostrarEventos  Boolean  @default(true)
  linksRapidos    String?
  updatedAt       DateTime @updatedAt

  @@map("site_config")
}

model Noticia {
  id             Int      @id @default(autoincrement())
  titulo         String
  descricao      String?
  conteudo       String?
  dataPublicacao DateTime @default(now())
  visivel        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("noticias")
}
