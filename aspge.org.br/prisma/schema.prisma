generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Associado {
  id                 Int          @id @default(autoincrement())
  nomeCompleto       String
  cpf                String       @unique
  rg                 String?
  expeditor          String?
  matricula          String?
  cargo              String?
  perfil             String       @default("Associado")
  situacao           String?
  sexo               String?
  whatsapp           String?
  email              String?
  senha              String?      // hash bcrypt (null até o associado definir)
  dataNascimento     DateTime?
  naturalidade       String?
  estadoCivil        String?
  graduacao          String?
  posGraduacao       String?
  areaAtuacao        String?
  lotacao            String?
  cep                String?
  endereco           String?
  numero             String?
  complemento        String?
  bairro             String?
  cidade             String?
  estado             String?
  tipoResidencia     String?      // 'Propria' ou 'Alugada'
  fotoUrl            String?
  fotoCarteirinhaUrl String?
  fotoConfig         String?      // JSON com zoom/posição
  cadastroCompleto   Boolean      @default(false)
  camposPreenchidos  Int          @default(0)
  // LGPD: consentimento registrado na inscrição e solicitação de exclusão
  consentimentoLgpd    Boolean      @default(false)
  consentimentoLgpdEm  DateTime?
  solicitouExclusao    Boolean      @default(false)
  solicitouExclusaoEm  DateTime?
  senhaAlterada      Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relações
  documentos       Documento[]
  logs             Log[]
  gestoes          Gestao[]
  votos            Voto[]
  inscricoesEvento InscricaoEvento[]
  dependentes      Dependente[]

  @@map("associados")
}

model Evento {
  id        Int      @id @default(autoincrement())
  data      DateTime
  titulo    String
  local     String?
  horario   String?
  descricao  String?
  visivel    Boolean  @default(true)
  createdAt  DateTime @default(now())

  inscricoes InscricaoEvento[]

  @@map("eventos")
}

model Convenio {
  id             Int      @id @default(autoincrement())
  nome           String
  descricao      String?
  categoria      String?
  link           String?
  visivel        Boolean  @default(true)
  numeroConvenio String?
  desconto       String?
  endereco       String?
  cnpj           String?
  telefone       String?
  condicoes      String?  @db.Text
  comoUsar       String?  @db.Text
  vigencia       String?
  createdAt      DateTime @default(now())

  @@map("convenios")
}

model Lancamento {
  id          Int      @id @default(autoincrement())
  data        DateTime
  descricao   String
  valor       Decimal  @db.Decimal(10, 2)
  tipo        String   // 'entrada' ou 'saida'
  responsavel String?
  createdAt   DateTime @default(now())

  @@map("lancamentos")
}

model Votacao {
  id        Int      @id @default(autoincrement())
  titulo    String
  status    String   @default("Aberta") // Aberta, Encerrada
  dataFim   String?
  votos     Int      @default(0) // desnormalizado: total de votos
  createdAt DateTime @default(now())

  opcoes OpcaoVoto[]
  votosRegistrados Voto[]

  @@map("votacoes")
}

model OpcaoVoto {
  id        Int     @id @default(autoincrement())
  votacaoId Int
  votacao   Votacao @relation(fields: [votacaoId], references: [id], onDelete: Cascade)
  texto     String
  votos     Voto[]

  @@map("opcoes_voto")
}

model Voto {
  id          Int       @id @default(autoincrement())
  votacaoId   Int
  votacao     Votacao   @relation(fields: [votacaoId], references: [id], onDelete: Cascade)
  opcaoId     Int
  opcao       OpcaoVoto @relation(fields: [opcaoId], references: [id], onDelete: Cascade)
  associadoId Int
  associado   Associado @relation(fields: [associadoId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([votacaoId, associadoId])
  @@index([opcaoId])
  @@map("votos")
}

model InscricaoEvento {
  id          Int       @id @default(autoincrement())
  eventoId    Int
  evento      Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  associadoId Int
  associado   Associado @relation(fields: [associadoId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([eventoId, associadoId])
  @@index([associadoId])
  @@map("inscricoes_evento")
}

model Dependente {
  id             Int       @id @default(autoincrement())
  associadoId    Int
  associado      Associado @relation(fields: [associadoId], references: [id], onDelete: Cascade)
  nome           String
  parentesco     String?
  dataNascimento DateTime?
  createdAt      DateTime  @default(now())

  @@index([associadoId])
  @@map("dependentes")
}

model Gestao {
  id        Int      @id @default(autoincrement())
  nome      String
  inicio    DateTime?
  fim       DateTime?
  ativa     Boolean  @default(false)
  createdAt DateTime @default(now())
  associados Associado[]
  membros    DiretoriaGestao[]

  @@map("gestoes")
}

model DiretoriaGestao {
  id       Int    @id @default(autoincrement())
  gestaoId Int
  gestao   Gestao @relation(fields: [gestaoId], references: [id], onDelete: Cascade)
  cpf      String
  nome     String
  cargo    String

  @@map("diretoria_gestao")
}

model Documento {
  id          Int       @id @default(autoincrement())
  nome        String
  path        String
  mimeType    String?
  tamanho     Int?
  associadoId Int
  associado   Associado @relation(fields: [associadoId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@map("documentos")
}

model Log {
  id          Int        @id @default(autoincrement())
  acao        String
  detalhes    String?
  associadoId Int?
  associado   Associado? @relation(fields: [associadoId], references: [id], onDelete: SetNull)
  ip          String?
  userAgent   String?
  createdAt   DateTime   @default(now())

  @@index([associadoId])
  @@index([createdAt])
  @@map("logs")
}

model ConfigCarteirinha {
  id             Int      @id @default(autoincrement())
  config         String   @db.Text // JSON com frame e campos
  templateFrente String?  // path do arquivo
  templateVerso  String?  // path do arquivo
  updatedAt      DateTime @updatedAt

  @@map("config_carteirinhas")
}

model SiteConfig {
  id             Int      @id @default(autoincrement())
  sobreTexto     String?  @db.Text
  missao         String?  @db.Text
  visao          String?  @db.Text
  valores        String?  @db.Text
  estatutos      String?  @db.Text
  bannerUrl      String?
  bannerAlt      String?
  mostrarEnquetes Boolean  @default(true)
  mostrarNoticias Boolean  @default(true)
  mostrarEventos Boolean  @default(true)
  linksRapidos   String?  @db.Text // JSON array de {titulo, url}
  contatoEndereco String? @db.Text
  contatoEmail   String?
  contatoTelefone String?
  redesSociais   String?  @db.Text // JSON array de {nome, url}
  updatedAt      DateTime @updatedAt

  @@map("site_config")
}

model IncidenteLgpd {
  id                    Int       @id @default(autoincrement())
  titulo                String
  descricao             String    @db.Text
  dataOcorrencia        DateTime
  dadosAfetados         String?   @db.Text // quais dados pessoais foram afetados
  titularesAfetados     String?   @db.Text // escopo/grupo de titulares afetados
  medidasTomadas        String?   @db.Text
  // Trilha de comunicação (LGPD art. 48)
  comunicadoAnpdEm      DateTime?
  notificadoTitularesEm DateTime?
  emailsEnviados        Int       @default(0)
  emailsFalhados        Int       @default(0)
  registradoPorId       Int?
  registradoPor         String?
  createdAt             DateTime  @default(now())

  @@map("incidentes_lgpd")
}

model Noticia {
  id              Int      @id @default(autoincrement())
  titulo          String
  descricao       String?
  conteudo        String?  @db.Text
  dataPublicacao  DateTime @default(now())
  visivel         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("noticias")
}
