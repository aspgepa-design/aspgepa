{
  "name": "aspge-api",
  "version": "2.0.0",
  "description": "Sistema ASPGE-PA - API Node.js/Express",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:deploy": "npx prisma migrate deploy",
    "versoes": "node scripts/gerar-versoes.js",
    "test:local": "npm run db:migrate && npm run dev"
  },
  "keywords": ["aspge", "associados", "pge-pa"],
  "author": "ASPGE-PA",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "@prisma/client": "^5.6.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "puppeteer": "^21.5.0",
    "pdf-lib": "^1.17.1",
    "ejs": "^3.1.9",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "express-validator": "^7.0.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "csv-parse": "^5.5.2",
    "googleapis": "^128.0.0"
  },
  "devDependencies": {
    "prisma": "^5.6.0",
    "nodemon": "^3.0.2"
  }
