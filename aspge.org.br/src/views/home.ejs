<style>
*{margin:0;padding:0;box-sizing:border-box}
html,body{font-family:'Inter',system-ui,-apple-system,sans-serif;background:#f8fafc;color:#1f2937;line-height:1.6}
html{scroll-behavior:smooth}
section[id]{scroll-margin-top:84px}
:focus-visible{outline:2px solid #0075bf;outline-offset:2px;border-radius:4px}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important;scroll-behavior:auto!important}}

/* HEADER */
.header{background:#fff;border-bottom:1px solid #e5e7eb;position:sticky;top:0;z-index:100}
.header-inner{max-width:1200px;margin:0 auto;padding:16px 24px;display:flex;justify-content:space-between;align-items:center}
.logo{display:flex;align-items:center;gap:12px;text-decoration:none}
.logo-img{width:48px;height:48px;object-fit:contain}
.logo-text{font-weight:900;color:#dc2626;font-size:20px;letter-spacing:-.5px}
.nav-links{display:flex;gap:8px}
.nav-link{padding:10px 20px;border-radius:8px;text-decoration:none;font-weight:600;font-size:14px;transition:.2s}
.nav-link-primary{background:#0075bf;color:#fff}.nav-link-primary:hover{background:#005a91}
.nav-link-secondary{color:#4b5563}.nav-link-secondary:hover{background:#f3f4f6}

/* HERO BANNER */
.hero{position:relative;background:linear-gradient(120deg,#0b2545 0%,#123f6d 55%,#0075bf 100%);color:#fff;padding:96px 24px;overflow:hidden}
.hero::after{content:'';position:absolute;left:0;right:0;bottom:0;height:6px;background:linear-gradient(90deg,#dc2626,#f59e0b)}
.hero-bg{position:absolute;top:0;right:0;bottom:0;left:0;background:url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="rgba(255,255,255,0.05)"/></svg>') center/cover;opacity:.3}
.hero-inner{max-width:1200px;margin:0 auto;position:relative;z-index:1}
.hero h1{font-size:48px;font-weight:900;margin-bottom:16px;line-height:1.1}
.hero p{font-size:20px;opacity:.9;max-width:600px;margin-bottom:32px}
.hero-btn{display:inline-block;padding:16px 32px;background:#fff;color:#dc2626;text-decoration:none;border-radius:12px;font-weight:700;font-size:16px;transition:.2s}
.hero-btn:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.2)}
.hero-btn-install{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.85);cursor:pointer;font-family:inherit}
.hero-btn-install:hover{background:rgba(255,255,255,.15)}

/* SECTIONS */
.section{padding:64px 24px}
.section-inner{max-width:1200px;margin:0 auto}
.section-title{font-size:32px;font-weight:900;color:#dc2626;margin-bottom:48px;text-align:center}

/* CARDS GRID */
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px}
.card{background:#fff;border-radius:16px;padding:32px;border:1px solid #e5e7eb;box-shadow:0 1px 3px rgba(0,0,0,.06)}
.card h3{font-size:20px;font-weight:700;color:#dc2626;margin-bottom:12px}
.card p{color:#6b7280;font-size:15px}

/* INFO CARDS */
.info-card{background:linear-gradient(135deg,#fee2e2 0%,#dcfce7 50%,#eff6ff 100%);border:1px solid #bfdbfe}
.info-card h3{color:#dc2626}
.info-card p{color:#dc2626}

/* NEWS CARDS */
.news-card{overflow:hidden}
.news-card h3{font-size:18px;margin-bottom:8px}
.news-date{font-size:12px;color:#9ca3af;margin-bottom:12px;display:block}
.news-desc{color:#6b7280;font-size:14px;line-height:1.5}

/* POLL CARD */
.poll-card{background:linear-gradient(135deg,#fef3c7 0%,#fde68a 100%);border:1px solid #fcd34d}
.poll-card h3{color:#92400e}
.poll-status{display:inline-block;padding:4px 12px;background:#fff;border-radius:99px;font-size:11px;font-weight:700;text-transform:uppercase;color:#92400e;margin-bottom:12px}

/* FOOTER */
.footer{background:#1e3a5f;color:#fff;padding:48px 24px}
.footer-inner{max-width:1200px;margin:0 auto}
.footer-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:32px;margin-bottom:32px}
.footer h4{font-size:16px;font-weight:700;margin-bottom:16px}
.footer a{color:#93c5fd;text-decoration:none;display:block;margin-bottom:8px;font-size:14px}
.footer a:hover{color:#fff}
.footer-bottom{border-top:1px solid rgba(255,255,255,.1);padding-top:24px;text-align:center;font-size:13px;opacity:.7}

/* SKELETONS */
.skeleton{position:relative;overflow:hidden;background:#e5e7eb;border-radius:8px}
.skeleton::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.55),transparent);animation:sk 1.4s infinite}
@keyframes sk{from{transform:translateX(-100%)}to{transform:translateX(100%)}}
.skel-card{height:130px;border-radius:16px}
.skel-line{display:block;height:14px;margin:6px 0}
.section-sub{text-align:center;color:#6b7280;margin:-30px 0 40px;font-size:16px}

/* HERO CTA */
.hero-cta{display:flex;gap:12px;flex-wrap:wrap}
.hero-btn-outline{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.85)}
.hero-btn-outline:hover{background:rgba(255,255,255,.12);transform:translateY(-2px)}

/* DIRETORIA */
.dir-card{text-align:center}
.dir-foto{width:88px;height:88px;border-radius:50%;object-fit:cover;margin:0 auto 14px;border:3px solid #fee2e2;display:block}
.dir-avatar{width:88px;height:88px;border-radius:50%;background:linear-gradient(135deg,#dc2626,#0075bf);color:#fff;font-weight:800;font-size:30px;display:flex;align-items:center;justify-content:center;margin:0 auto 14px}
.dir-cargo{color:#dc2626;font-weight:600}

/* CONVÊNIOS */
.conv-card{text-decoration:none;color:inherit;display:block;transition:.2s}
.conv-card:hover{transform:translateY(-3px);box-shadow:0 8px 24px rgba(0,0,0,.08);border-color:#0075bf}
.conv-cat{display:inline-block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:#0075bf;background:#eff6ff;padding:3px 10px;border-radius:99px;margin-bottom:10px}
.conv-link{display:inline-block;margin-top:14px;color:#0075bf;font-weight:600;font-size:13px}

/* NOTÍCIAS */
.news-link-card{text-decoration:none;color:inherit;display:block;transition:.2s}
.news-link-card:hover{transform:translateY(-3px);box-shadow:0 8px 24px rgba(0,0,0,.08);border-color:#0075bf}
.news-link{display:inline-block;margin-top:12px;color:#0075bf;font-weight:600;font-size:13px}

/* CTA BAND */
.cta-band{background:linear-gradient(120deg,#dc2626,#b91c1c);color:#fff;padding:64px 24px}

/* PWA MODAL */
.pwa-modal{position:fixed;inset:0;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;z-index:300;padding:20px}
.pwa-modal-box{background:#fff;border-radius:16px;padding:30px;max-width:420px;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.3)}
.pwa-modal-box h3{color:#dc2626;margin-bottom:12px;font-size:20px}
.pwa-modal-box p{color:#4b5563;font-size:15px;margin-bottom:22px;white-space:pre-line;line-height:1.6}

/* RESPONSIVE */
@media(max-width:768px){
  .hero h1{font-size:32px}
  .hero p{font-size:16px}
  .section-title{font-size:24px}
  .header{position:static}
  .header-inner{flex-direction:row;flex-wrap:wrap;gap:10px;padding:12px 16px}
  .nav-links{flex-direction:row;flex-wrap:nowrap;overflow-x:auto;width:100%;gap:6px;padding-bottom:4px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
  .nav-links::-webkit-scrollbar{display:none}
  .nav-link{text-align:center;white-space:nowrap;padding:8px 14px;font-size:13px;flex-shrink:0}
  .hero{padding:64px 24px}
  .hero-cta{flex-direction:column;align-items:stretch}
  .hero-cta .hero-btn{text-align:center}
}
</style>
