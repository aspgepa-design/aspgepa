<script>
// Escapa HTML p/ evitar XSS ao injetar dados via innerHTML
function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }

async function carregarConfig() {
  try {
    const response = await fetch('/api/site-config');
    const data = await response.json();
    
    if (data.sucesso && data.dados) {
      const config = data.dados;
      
      // Atualizar textos
      if (config.sobreTexto) document.getElementById('hero-subtitle').textContent = config.sobreTexto;
      if (config.missao) document.getElementById('missao-text').textContent = config.missao;
      if (config.visao) document.getElementById('visao-text').textContent = config.visao;
      if (config.valores) document.getElementById('valores-text').textContent = config.valores;
      
      // Mostrar/ocultar seções (e os respectivos links do menu)
      if (config.mostrarNoticias) { document.getElementById('noticias').style.display = 'block'; document.getElementById('nav-noticias').style.display = ''; }
      if (config.mostrarEnquetes) { document.getElementById('enquetes').style.display = 'block'; document.getElementById('nav-enquetes').style.display = ''; }
      
      // Links rápidos
      if (config.linksRapidos && config.linksRapidos.length > 0) {
        const linksContainer = document.getElementById('links-rapidos');
        linksContainer.innerHTML = config.linksRapidos.map(function(link){
          var url = String(link.url || '#');
          if (/^\s*javascript:/i.test(url)) url = '#'; // bloqueia javascript:
          return '<a href="' + esc(url) + '">' + esc(link.titulo) + '</a>';
        }).join('');
      }
    }
  } catch (error) {
    console.error('Erro ao carregar configurações:', error);
    // Fallback p/ não ficar "Carregando..." indefinidamente
    var fb = { 'missao-text':'Nossa missão.', 'visao-text':'Nossa visão.', 'valores-text':'Nossos valores.' };
    for (var id in fb) { var el = document.getElementById(id); if (el && el.textContent === 'Carregando...') el.textContent = fb[id]; }
  }
}

async function carregarNoticias() {
  try {
    const response = await fetch('/api/noticias?limite=3');
    const data = await response.json();
    
    if (data.sucesso && data.dados && data.dados.length > 0) {
      const grid = document.getElementById('noticias-grid');
      grid.innerHTML = data.dados.map(function(noticia){
        var conteudo = String(noticia.conteudo || '');
        var desc = noticia.descricao || conteudo.substring(0, 150);
        if (!noticia.descricao && conteudo.length > 150) desc += '...';
        var d = noticia.dataPublicacao ? new Date(noticia.dataPublicacao) : null;
        var dataTxt = (d && !isNaN(d)) ? d.toLocaleDateString('pt-BR') : '';
        return '<a href="/noticias/' + noticia.id + '" class="card news-card news-link-card"><h3>' + esc(noticia.titulo) + '</h3>' +
               (dataTxt ? '<span class="news-date">' + dataTxt + '</span>' : '') +
               '<p class="news-desc">' + esc(desc) + '</p><span class="news-link">Ler mais →</span></a>';
      }).join('');
    } else {
      document.getElementById('noticias-grid').innerHTML = '<p>Nenhuma notícia publicada.</p>';
    }
  } catch (error) {
    console.error('Erro ao carregar notícias:', error);
  }
}

async function carregarEnquetes() {
  try {
    const response = await fetch('/api/votacoes');
    const data = await response.json();
    
    if (data.sucesso && data.dados && data.dados.length > 0) {
      const enquetesAbertas = data.dados.filter(v => v.status === 'Aberta');
      
      if (enquetesAbertas.length > 0) {
        const grid = document.getElementById('enquetes-grid');
        grid.innerHTML = enquetesAbertas.map(function(enquete){
          var votos = (enquete.votos != null ? enquete.votos : (enquete.totalVotos != null ? enquete.totalVotos : 0));
          return '<div class="card poll-card"><span class="poll-status">' + esc(enquete.status) + '</span>' +
                 '<h3>' + esc(enquete.titulo) + '</h3>' +
                 '<p style="color:#92400e;font-size:14px;margin-top:8px">' + votos + ' votos</p>' +
                 '<a href="/login" style="display:inline-block;margin-top:12px;padding:8px 16px;background:#fff;color:#92400e;text-decoration:none;border-radius:8px;font-weight:600;font-size:12px">Participar</a></div>';
        }).join('');
      } else {
        document.getElementById('enquetes-grid').innerHTML = '<p>Nenhuma enquete aberta no momento.</p>';
      }
    } else {
      document.getElementById('enquetes-grid').innerHTML = '<p>Nenhuma enquete disponível.</p>';
    }
  } catch (error) {
    console.error('Erro ao carregar enquetes:', error);
    document.getElementById('enquetes-grid').innerHTML = '<p>Erro ao carregar enquetes.</p>';
  }
}

async function carregarConvenios() {
  try {
    const response = await fetch('/api/convenios/publicos');
    const data = await response.json();
    const lista = data.dados || (Array.isArray(data) ? data : []);
    if (lista.length > 0) {
      document.getElementById('convenios').style.display = 'block';
      document.getElementById('nav-convenios').style.display = '';
      document.getElementById('convenios-grid').innerHTML = lista.map(function(c){
        var inner = '<span class="conv-cat">' + esc(c.categoria || 'Convênio') + '</span><h3>' + esc(c.nome) + '</h3>' +
                    (c.descricao ? '<p>' + esc(c.descricao) + '</p>' : '');
        return c.link
          ? '<a class="card conv-card" href="' + esc(c.link) + '" target="_blank" rel="noopener">' + inner + '<span class="conv-link">Acessar →</span></a>'
          : '<div class="card conv-card">' + inner + '</div>';
      }).join('');
    }
  } catch (e) { console.error('Erro ao carregar convênios:', e); }
}

// Carregar dados ao iniciar
document.getElementById('footer-ano').textContent = new Date().getFullYear();
carregarConfig();
carregarNoticias();
carregarEnquetes();
carregarConvenios();
</script>

<!-- MODAL INSTALAR PWA -->
<div id="pwaModal" class="pwa-modal" style="display:none" role="dialog" aria-modal="true" aria-labelledby="pwaModalTitle">
  <div class="pwa-modal-box">
    <h3 id="pwaModalTitle">📲 Instalar Aplicativo</h3>
    <p id="pwaModalText"></p>
    <button class="hero-btn" style="padding:10px 26px;font-size:14px;color:#fff;background:#0075bf" onclick="document.getElementById('pwaModal').style.display='none'">Entendi</button>
  </div>
</div>

<script>
// ===== BOTÃO INSTALAR / ACESSAR PWA =====
var pwaDeferredPrompt = null;
var btnInstalar = document.getElementById('btnInstalar');
var pwaStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
var isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);

function setBtnInstalar(modo) {
  if (modo === 'oculto') { btnInstalar.style.display = 'none'; return; }
  btnInstalar.style.display = 'inline-block';
  btnInstalar.dataset.modo = modo;
  btnInstalar.textContent = modo === 'acessar' ? '📱 Acessar Aplicativo' : '📲 Instalar Aplicativo';
}

async function pwaJaInstalado() {
  if (pwaStandalone) return true;
  if ('getInstalledRelatedApps' in navigator) {
    try { var apps = await navigator.getInstalledRelatedApps(); return !!(apps && apps.length); }
    catch (e) { return false; }
  }
  return false;
}

function instalarOuAcessar() {
  if (btnInstalar.dataset.modo === 'acessar') { window.location.href = '/portal'; return; }
  if (pwaDeferredPrompt) {
    pwaDeferredPrompt.prompt();
    pwaDeferredPrompt.userChoice.then(function (choice) {
      if (choice.outcome === 'accepted') setBtnInstalar('acessar');
      pwaDeferredPrompt = null;
    });
  } else if (isIOS) {
    abrirPwaModal('Para instalar no iPhone/iPad:\n\n1. Toque em Compartilhar (quadrado com seta)\n2. Toque em "Adicionar à Tela de Início"\n3. Toque em "Adicionar"');
  } else {
    abrirPwaModal('Para instalar, abra o menu do navegador e toque em "Instalar app" ou "Adicionar à tela inicial".');
  }
}

function abrirPwaModal(texto) {
  document.getElementById('pwaModalText').textContent = texto;
  document.getElementById('pwaModal').style.display = 'flex';
}

window.addEventListener('beforeinstallprompt', function (e) {
  e.preventDefault();
  pwaDeferredPrompt = e;
  if (btnInstalar.dataset.modo !== 'acessar') setBtnInstalar('instalar');
});

window.addEventListener('appinstalled', function () {
  pwaDeferredPrompt = null;
  setBtnInstalar('acessar');
});

// Estado inicial do botão
(async function () {
  if (await pwaJaInstalado()) { setBtnInstalar('acessar'); return; }
  if (isIOS) { setBtnInstalar('instalar'); } // iOS: instalação manual via Safari
  // Android/desktop: aguarda beforeinstallprompt; se não disparar, o botão fica oculto
})();

// Fechar modal ao clicar no fundo
document.getElementById('pwaModal').addEventListener('click', function (e) { if (e.target === this) this.style.display = 'none'; });
</script>

<script>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', function () {
    navigator.serviceWorker.register('/sw.js').catch(function () {});
  });
}
</script>
</body>
</html>
