<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Atualização Cadastral - ASPGE-PA</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: linear-gradient(135deg, #dc2626 0%, #16a34a 50%, #0075bf 100%);
      min-height: 100vh;
      padding: 40px 20px;
    }
    .container {
      max-width: 800px;
      margin: 0 auto;
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      padding: 40px;
    }
    .header {
      text-align: center;
      margin-bottom: 40px;
    }
    .logo {
      width: 80px;
      height: 80px;
      background: linear-gradient(135deg, #dc2626, #0075bf);
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      color: #fff;
      font-weight: 800;
      font-size: 28px;
    }
    h1 {
      font-size: 28px;
      font-weight: 800;
      color: #1f2937;
      margin-bottom: 8px;
    }
    .subtitle {
      color: #6b7280;
      font-size: 14px;
    }
    .search-section {
      background: #f9fafb;
      padding: 24px;
      border-radius: 16px;
      margin-bottom: 32px;
    }
    .search-input {
      display: flex;
      gap: 12px;
    }
    .search-input input {
      flex: 1;
      padding: 14px 16px;
      border: 2px solid #e5e7eb;
      border-radius: 12px;
      font-size: 15px;
    }
    .search-input button {
      padding: 14px 24px;
      background: linear-gradient(135deg, #dc2626, #0075bf);
      color: #fff;
      border: none;
      border-radius: 12px;
      font-weight: 700;
      cursor: pointer;
    }
    .cep-input {
      display: flex;
      gap: 10px;
      align-items: center;
    }
    .cep-input input {
      flex: 1;
    }
    .cep-input button {
      padding: 12px 18px;
      background: linear-gradient(135deg, #dc2626, #0075bf);
      color: #fff;
      border: none;
      border-radius: 10px;
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
      white-space: nowrap;
    }
    .cep-input button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
    .cep-loading {
      font-size: 12px;
      color: #0075bf;
      margin-top: 4px;
    }
    .cep-erro {
      font-size: 12px;
      color: #dc2626;
      margin-top: 4px;
    }
    .form-section {
      margin-bottom: 32px;
    }
    .section-title {
      font-size: 16px;
      font-weight: 700;
      color: #1e3a5f;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 2px solid #e5e7eb;
    }
    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }
    .form-group {
      display: flex;
      flex-direction: column;
    }
    .form-group.full {
      grid-column: 1 / -1;
    }
    label {
      font-size: 13px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
    }
    .tag {
      font-size: 10px;
      padding: 4px 8px;
      border-radius: 4px;
      font-weight: 700;
    }
    .tag-ok {
      background: #d1fae5;
      color: #065f46;
    }
    .tag-pendente {
      background: #fee2e2;
      color: #991b1b;
    }
    input, select {
      padding: 14px 16px;
      border: 2px solid #e5e7eb;
      border-radius: 12px;
      font-size: 15px;
      font-family: inherit;
    }
    input:focus, select:focus {
      outline: none;
      border-color: #dc2626;
    }
    input.preenchido {
      border-color: #10b981;
      background: #ecfdf5;
    }
    input.vazio {
      border-color: #f59e0b;
      background: #fffbeb;
    }
    .btn-submit {
      width: 100%;
      padding: 18px;
      background: linear-gradient(135deg, #dc2626, #0075bf);
      color: #fff;
      border: none;
      border-radius: 12px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
    }
    .btn-submit:disabled {
      opacity: 0.7;
      cursor: not-allowed;
    }
    .status {
      text-align: center;
      margin-top: 20px;
      padding: 16px;
      border-radius: 12px;
      font-weight: 600;
      display: none;
    }
    .status.success {
      background: #d1fae5;
      color: #065f46;
      display: block;
    }
    .status.error {
      background: #fee2e2;
      color: #991b1b;
      display: block;
    }
    .hidden {
      display: none;
    }
    .back-link {
      display: block;
      text-align: center;
      margin-top: 24px;
      color: #667eea;
      text-decoration: none;
      font-weight: 600;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="logo">A</div>
      <h1>Atualização Cadastral</h1>
      <p class="subtitle">Atualize seus dados cadastrais na ASPGE-PA</p>
    </div>
    
    <div class="search-section" id="secaoBusca">
      <h3 style="margin-bottom:16px;font-size:16px">Buscar Associado</h3>
      <div class="search-input">
        <input type="text" id="buscaCpf" placeholder="Digite seu CF">
        <button onclick="buscarAssociado()">Buscar</button>
      </div>
      <p id="buscaStatus" style="margin-top:12px;font-size:14px;color:#6b7280"></p>
    </div>
    
    <form id="formAtualizacao" class="hidden">
      <div id="dadosHeader" style="margin-bottom:24px;padding:16px;background:#f9fafb;border-radius:12px;">
        <h3 id="nomeAssociado" style="font-size:18px;font-weight:700"></h3>
      </div>
      
      <div class="form-section">
        <h2 class="section-title">Dados Pessoais</h2>
        <div class="form-grid">
          <div class="form-group">
            <label>RG <span class="tag tag-pendente" id="tagRg">PENDENTE</span></label>
            <input type="text" id="rg" name="rg">
          </div>
          <div class="form-group">
            <label>Órgão Expedidor <span class="tag tag-pendente" id="tagExpeditor">PENDENTE</span></label>
            <input type="text" id="expeditor" name="expeditor">
          </div>
          <div class="form-group">
            <label>Matrícula <span class="tag tag-pendente" id="tagMatricula">PENDENTE</span></label>
            <input type="text" id="matricula" name="matricula">
          </div>
          <div class="form-group">
            <label>Cargo <span class="tag tag-pendente" id="tagCargo">PENDENTE</span></label>
            <input type="text" id="cargo" name="cargo">
          </div>
          <div class="form-group">
            <label>WhatsApp <span class="tag tag-pendente" id="tagWhatsapp">PENDENTE</span></label>
            <input type="text" id="whatsapp" name="whatsapp">
          </div>
          <div class="form-group">
            <label>Email <span class="tag tag-pendente" id="tagEmail">PENDENTE</span></label>
            <input type="email" id="email" name="email">
          </div>
          <div class="form-group">
            <label>Data de Nascimento <span class="tag tag-pendente" id="tagDataNascimento">PENDENTE</span></label>
            <input type="date" id="dataNascimento" name="dataNascimento">
          </div>
          <div class="form-group">
            <label>Estado Civil <span class="tag tag-pendente" id="tagEstadoCivil">PENDENTE</span></label>
            <select id="estadoCivil" name="estadoCivil">
              <option value="">Selecione</option>
              <option value="Solteiro">Solteiro(a)</option>
              <option value="Casado">Casado(a)</option>
              <option value="Divorciado">Divorciado(a)</option>
              <option value="Viúvo">Viúvo(a)</option>
              <option value="União Estável">União Estável</option>
            </select>
          </div>
        </div>
      </div>
      
      <div class="form-section">
        <h2 class="section-title">Endereço Completo</h2>
        <div class="form-grid">
          <div class="form-group">
            <label>CEP <span class="tag tag-pendente" id="tagCep">PENDENTE</span></label>
            <div class="cep-input">
              <input type="text" id="cep" name="cep" maxlength="9" placeholder="00000-000">
              <button type="button" onclick="buscarCep()" id="btnBuscarCep">Buscar CEP</button>
            </div>
            <div id="cepStatus"></div>
          </div>
          <div class="form-group">
            <label>Endereço <span class="tag tag-pendente" id="tagEndereco">PENDENTE</span></label>
            <input type="text" id="endereco" name="endereco">
          </div>
          <div class="form-group">
            <label>Número <span class="tag tag-pendente" id="tagNumero">PENDENTE</span></label>
            <input type="text" id="numero" name="numero">
          </div>
          <div class="form-group">
            <label>Complemento</label>
            <input type="text" id="complemento" name="complemento">
          </div>
          <div class="form-group">
            <label>Bairro <span class="tag tag-pendente" id="tagBairro">PENDENTE</span></label>
            <input type="text" id="bairro" name="bairro">
          </div>
          <div class="form-group">
            <label>Cidade <span class="tag tag-pendente" id="tagCidade">PENDENTE</span></label>
            <input type="text" id="cidade" name="cidade">
          </div>
          <div class="form-group">
            <label>Estado <span class="tag tag-pendente" id="tagEstado">PENDENTE</span></label>
            <select id="estado" name="estado">
              <option value="">Selecione</option>
              <option value="AC">Acre</option>
              <option value="AL">Alagoas</option>
              <option value="AP">Amapá</option>
              <option value="AM">Amazonas</option>
              <option value="BA">Bahia</option>
              <option value="CE">Ceará</option>
              <option value="DF">Distrito Federal</option>
              <option value="ES">Espírito Santo</option>
              <option value="GO">Goiás</option>
              <option value="MA">Maranhão</option>
              <option value="MT">Mato Grosso</option>
              <option value="MS">Mato Grosso do Sul</option>
              <option value="MG">Minas Gerais</option>
              <option value="PA">Pará</option>
              <option value="PB">Paraíba</option>
              <option value="PR">Paraná</option>
              <option value="PE">Pernambuco</option>
              <option value="PI">Piauí</option>
              <option value="RJ">Rio de Janeiro</option>
              <option value="RN">Rio Grande do Norte</option>
              <option value="RS">Rio Grande do Sul</option>
              <option value="RO">Rondônia</option>
              <option value="RR">Roraima</option>
              <option value="SC">Santa Catarina</option>
              <option value="SP">São Paulo</option>
              <option value="SE">Sergipe</option>
              <option value="TO">Tocantins</option>
            </select>
          </div>
          <div class="form-group">
            <label>Tipo de Residência <span class="tag tag-pendente" id="tagTipoResidencia">PENDENTE</span></label>
            <select id="tipoResidencia" name="tipoResidencia">
              <option value="">Selecione</option>
              <option value="Propria">Própria</option>
              <option value="Alugada">Alugada</option>
            </select>
          </div>
        </div>
      </div>
      
      <div class="form-section">
        <h2 class="section-title">Alteração de Senha</h2>
        <div class="form-grid">
          <div class="form-group">
            <label>Senha Atual <span class="tag tag-pendente" id="tagSenhaAtual">OBRIGATÓRIO</span></label>
            <input type="password" id="senhaAtual" name="senhaAtual" placeholder="Digite sua senha atual (CPF)">
          </div>
          <div class="form-group">
            <label>Nova Senha <span class="tag tag-pendente" id="tagNovaSenha">OBRIGATÓRIO</span></label>
            <input type="password" id="novaSenha" name="novaSenha" placeholder="Digite sua nova senha">
          </div>
          <div class="form-group">
            <label>Confirmar Nova Senha <span class="tag tag-pendente" id="tagConfirmarNovaSenha">OBRIGATÓRIO</span></label>
            <input type="password" id="confirmarNovaSenha" name="confirmarNovaSenha" placeholder="Confirme sua nova senha">
          </div>
        </div>
        <p style="margin-top:12px;font-size:13px;color:#6b7280">
          <strong>Atenção:</strong> Sua senha inicial é o seu CPF. Por segurança, você deve alterá-la no primeiro acesso.
        </p>
      </div>
      
      <button type="submit" class="btn-submit" id="btnSubmit">Salvar Alterações</button>
      
      <div id="statusMsg" class="status"></div>
    </form>
    
    <a href="/" class="back-link">← Voltar para o login</a>
  </div>

  <script>
    let associadoId = null;
    let cpfAssociado = null;
    
    function maskCep(value) {
      return value.replace(/\D/g, '')
        .replace(/(\d{5})(\d)/, '$1-$2');
    }
    
    function maskCpf(value) {
      return value.replace(/\D/g, '')
        .replace(/(\d{3})(\d)/, '$1.$2')
        .replace(/(\d{3})(\d)/, '$1.$2')
        .replace(/(\d{3})(\d{1,2})$/, '$1-$2');
    }
    
    function maskWhatsapp(value) {
      return value.replace(/\D/g, '')
        .replace(/(\d{2})(\d)/, '($1) $2')
        .replace(/(\d{5})(\d)/, '$1-$2');
    }
    
    document.getElementById('buscaCpf').addEventListener('input', function(e) {
      e.target.value = maskCpf(e.target.value);
    });
    
    document.getElementById('cep').addEventListener('input', function(e) {
      e.target.value = maskCep(e.target.value);
      const cepLimpo = e.target.value.replace(/\D/g, '');
      if (cepLimpo.length === 8) {
        buscarCep();
      }
    });
    
    document.getElementById('cep').addEventListener('blur', function(e) {
      const cepLimpo = e.target.value.replace(/\D/g, '');
      if (cepLimpo.length === 8) {
        buscarCep();
      }
    });
    
    document.getElementById('whatsapp').addEventListener('input', function(e) {
      e.target.value = maskWhatsapp(e.target.value);
    });
    
    async function buscarCep() {
      const cepInput = document.getElementById('cep');
      const statusDiv = document.getElementById('cepStatus');
      const btn = document.getElementById('btnBuscarCep');
      const cep = cepInput.value.replace(/\D/g, '');
      
      if (cep.length !== 8) {
        statusDiv.className = 'cep-erro';
        statusDiv.textContent = 'CEP inválido. Digite 8 dígitos.';
        return;
      }
      
      btn.disabled = true;
      statusDiv.className = 'cep-loading';
      statusDiv.textContent = 'Buscando endereço...';
      
      try {
        const response = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
        const data = await response.json();
        
        if (data.erro) {
          statusDiv.className = 'cep-erro';
          statusDiv.textContent = 'CEP não encontrado. Verifique e tente novamente.';
          btn.disabled = false;
          return;
        }
        
        // Preencher campos de endereço
        document.getElementById('endereco').value = data.logradouro || '';
        document.getElementById('bairro').value = data.bairro || '';
        document.getElementById('cidade').value = data.localidade || '';
        document.getElementById('estado').value = data.uf || '';
        
        // Atualizar tags de status
        atualizarTag('endereco', data.logradouro);
        atualizarTag('bairro', data.bairro);
        atualizarTag('cidade', data.localidade);
        atualizarTag('estado', data.uf);
        
        // Limpar status
        statusDiv.textContent = '';
        statusDiv.className = '';
        
        // Focar no campo número para continuar preenchimento
        document.getElementById('numero').focus();
        
      } catch (error) {
        statusDiv.className = 'cep-erro';
        statusDiv.textContent = 'Erro ao buscar CEP. Tente novamente.';
      } finally {
        btn.disabled = false;
      }
    }
    
    // Carregar dados automaticamente se usuário estiver logado
    async function carregarDadosLogado() {
      const token = localStorage.getItem('token');
      if (!token) return;
      
      try {
        const response = await fetch('/api/auth/perfil', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const data = await response.json();
        
        if (data.sucesso) {
          associadoId = data.dados.id;
          cpfAssociado = data.dados.cpf;
          
          document.getElementById('nomeAssociado').textContent = data.dados.nomeCompleto;
          
          // Preencher campos
          document.getElementById('rg').value = data.dados.rg || '';
          document.getElementById('expeditor').value = data.dados.expeditor || '';
          document.getElementById('matricula').value = data.dados.matricula || '';
          document.getElementById('cargo').value = data.dados.cargo || '';
          document.getElementById('whatsapp').value = data.dados.whatsapp || '';
          document.getElementById('email').value = data.dados.email || '';
          document.getElementById('dataNascimento').value = data.dados.dataNascimento ? data.dados.dataNascimento.split('T')[0] : '';
          document.getElementById('estadoCivil').value = data.dados.estadoCivil || '';
          document.getElementById('cep').value = data.dados.cep || '';
          document.getElementById('endereco').value = data.dados.endereco || '';
          document.getElementById('numero').value = data.dados.numero || '';
          document.getElementById('complemento').value = data.dados.complemento || '';
          document.getElementById('bairro').value = data.dados.bairro || '';
          document.getElementById('cidade').value = data.dados.cidade || '';
          document.getElementById('estado').value = data.dados.estado || '';
          document.getElementById('tipoResidencia').value = data.dados.tipoResidencia || '';
          
          // Atualizar tags
          atualizarTag('rg', data.dados.rg);
          atualizarTag('expeditor', data.dados.expeditor);
          atualizarTag('matricula', data.dados.matricula);
          atualizarTag('cargo', data.dados.cargo);
          atualizarTag('whatsapp', data.dados.whatsapp);
          atualizarTag('email', data.dados.email);
          atualizarTag('dataNascimento', data.dados.dataNascimento);
          atualizarTag('estadoCivil', data.dados.estadoCivil);
          atualizarTag('cep', data.dados.cep);
          atualizarTag('endereco', data.dados.endereco);
          atualizarTag('numero', data.dados.numero);
          atualizarTag('bairro', data.dados.bairro);
          atualizarTag('cidade', data.dados.cidade);
          atualizarTag('estado', data.dados.estado);
          atualizarTag('tipoResidencia', data.dados.tipoResidencia);
          
          // Verificar se senha já foi alterada
          if (data.dados.senhaAlterada) {
            document.getElementById('senhaAtual').placeholder = 'Senha já alterada (opcional)';
            document.getElementById('tagSenhaAtual').textContent = 'OK';
            document.getElementById('tagSenhaAtual').className = 'tag tag-ok';
            document.getElementById('novaSenha').placeholder = 'Nova senha (opcional)';
            document.getElementById('confirmarNovaSenha').placeholder = 'Confirmar (opcional)';
            document.getElementById('tagNovaSenha').textContent = 'OPCIONAL';
            document.getElementById('tagNovaSenha').className = 'tag tag-ok';
            document.getElementById('tagConfirmarNovaSenha').textContent = 'OPCIONAL';
            document.getElementById('tagConfirmarNovaSenha').className = 'tag tag-ok';
          }
          
          document.getElementById('secaoBusca').classList.add('hidden');
          document.getElementById('formAtualizacao').classList.remove('hidden');
        }
      } catch (error) {
        console.error('Erro ao carregar dados do usuário logado:', error);
      }
    }
    
    // Tentar carregar dados do usuário logado ao iniciar
    carregarDadosLogado();
    
    async function buscarAssociado() {
      const cpf = document.getElementById('buscaCpf').value;
      const status = document.getElementById('buscaStatus');
      
      status.textContent = 'Buscando...';
      
      try {
        const response = await fetch(`/api/associados/cpf/${cpf}`);
        const data = await response.json();
        
        if (data.sucesso) {
          associadoId = data.dados.id;
          cpfAssociado = data.dados.cpf;
          
          document.getElementById('nomeAssociado').textContent = data.dados.nomeCompleto;
          
          // Preencher campos
          document.getElementById('rg').value = data.dados.rg || '';
          document.getElementById('expeditor').value = data.dados.expeditor || '';
          document.getElementById('matricula').value = data.dados.matricula || '';
          document.getElementById('cargo').value = data.dados.cargo || '';
          document.getElementById('whatsapp').value = data.dados.whatsapp || '';
          document.getElementById('email').value = data.dados.email || '';
          document.getElementById('dataNascimento').value = data.dados.dataNascimento ? data.dados.dataNascimento.split('T')[0] : '';
          document.getElementById('estadoCivil').value = data.dados.estadoCivil || '';
          document.getElementById('cep').value = data.dados.cep || '';
          document.getElementById('endereco').value = data.dados.endereco || '';
          document.getElementById('numero').value = data.dados.numero || '';
          document.getElementById('complemento').value = data.dados.complemento || '';
          document.getElementById('bairro').value = data.dados.bairro || '';
          document.getElementById('cidade').value = data.dados.cidade || '';
          document.getElementById('estado').value = data.dados.estado || '';
          document.getElementById('tipoResidencia').value = data.dados.tipoResidencia || '';
          
          // Atualizar tags
          atualizarTag('rg', data.dados.rg);
          atualizarTag('expeditor', data.dados.expeditor);
          atualizarTag('matricula', data.dados.matricula);
          atualizarTag('cargo', data.dados.cargo);
          atualizarTag('whatsapp', data.dados.whatsapp);
          atualizarTag('email', data.dados.email);
          atualizarTag('dataNascimento', data.dados.dataNascimento);
          atualizarTag('estadoCivil', data.dados.estadoCivil);
          atualizarTag('cep', data.dados.cep);
          atualizarTag('endereco', data.dados.endereco);
          atualizarTag('numero', data.dados.numero);
          atualizarTag('bairro', data.dados.bairro);
          atualizarTag('cidade', data.dados.cidade);
          atualizarTag('estado', data.dados.estado);
          atualizarTag('tipoResidencia', data.dados.tipoResidencia);
          
          // Verificar se senha já foi alterada
          if (data.dados.senhaAlterada) {
            document.getElementById('senhaAtual').placeholder = 'Senha já alterada (opcional)';
            document.getElementById('tagSenhaAtual').textContent = 'OK';
            document.getElementById('tagSenhaAtual').className = 'tag tag-ok';
            document.getElementById('novaSenha').placeholder = 'Nova senha (opcional)';
            document.getElementById('confirmarNovaSenha').placeholder = 'Confirmar (opcional)';
            document.getElementById('tagNovaSenha').textContent = 'OPCIONAL';
            document.getElementById('tagNovaSenha').className = 'tag tag-ok';
            document.getElementById('tagConfirmarNovaSenha').textContent = 'OPCIONAL';
            document.getElementById('tagConfirmarNovaSenha').className = 'tag tag-ok';
          }
          
          document.getElementById('secaoBusca').classList.add('hidden');
          document.getElementById('formAtualizacao').classList.remove('hidden');
        } else {
          status.textContent = data.erro || 'Associado não encontrado.';
        }
      } catch (error) {
        status.textContent = 'Erro de conexão. Tente novamente.';
      }
    }
    
    function atualizarTag(campo, valor) {
      const tag = document.getElementById('tag' + campo.charAt(0).toUpperCase() + campo.slice(1));
      const input = document.getElementById(campo);
      
      if (valor && valor.trim() !== '' && valor.toLowerCase() !== 'não') {
        tag.textContent = '✓ OK';
        tag.className = 'tag tag-ok';
        input.classList.add('preenchido');
        input.classList.remove('vazio');
      } else {
        tag.textContent = 'PENDENTE';
        tag.className = 'tag tag-pendente';
        input.classList.add('vazio');
        input.classList.remove('preenchido');
      }
    }
    
    // Atualizar tags ao digitar
    const camposObrigatorios = ['rg', 'expeditor', 'matricula', 'cargo', 'whatsapp', 'email', 'dataNascimento', 'estadoCivil', 'cep', 'endereco', 'numero', 'bairro', 'cidade', 'estado', 'tipoResidencia'];
    camposObrigatorios.forEach(campo => {
      const elemento = document.getElementById(campo);
      if (elemento) {
        elemento.addEventListener('input', function() {
          atualizarTag(campo, this.value);
        });
      }
    });
    
    // Validar senha atual
    document.getElementById('senhaAtual').addEventListener('input', function() {
      const tag = document.getElementById('tagSenhaAtual');
      if (this.value && this.value.length >= 6) {
        tag.textContent = '✓ OK';
        tag.className = 'tag tag-ok';
      } else {
        tag.textContent = 'OBRIGATÓRIO';
        tag.className = 'tag tag-pendente';
      }
    });
    
    // Validar nova senha
    document.getElementById('novaSenha').addEventListener('input', function() {
      const tag = document.getElementById('tagNovaSenha');
      if (this.value && this.value.length >= 6) {
        tag.textContent = '✓ OK';
        tag.className = 'tag tag-ok';
      } else {
        tag.textContent = 'OBRIGATÓRIO';
        tag.className = 'tag tag-pendente';
      }
    });
    
    // Validar confirmação de nova senha
    document.getElementById('confirmarNovaSenha').addEventListener('input', function() {
      const tag = document.getElementById('tagConfirmarNovaSenha');
      const novaSenha = document.getElementById('novaSenha').value;
      if (this.value === novaSenha && this.value.length >= 6) {
        tag.textContent = '✓ OK';
        tag.className = 'tag tag-ok';
      } else {
        tag.textContent = 'OBRIGATÓRIO';
        tag.className = 'tag tag-pendente';
      }
    });
    
    // Submit
    document.getElementById('formAtualizacao').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const btn = document.getElementById('btnSubmit');
      const status = document.getElementById('statusMsg');
      
      btn.disabled = true;
      btn.textContent = 'Salvando...';
      status.className = 'status';
      
      if (!associadoId || !cpfAssociado) {
        status.className = 'status error';
        status.textContent = 'Busque seu CPF antes de salvar.';
        btn.disabled = false;
        btn.textContent = 'Salvar Alterações';
        return;
      }
      
      const formData = new FormData(this);
      const data = Object.fromEntries(formData);
      
      // Adicionar CPF ao body para autenticação
      data.cpf = cpfAssociado;
      
      // Converter dataNascimento para formato ISO se existir
      if (data.dataNascimento) {
        data.dataNascimento = new Date(data.dataNascimento).toISOString();
      }
      
      // Validar senha atual
      if (!data.senhaAtual) {
        status.className = 'status error';
        status.textContent = 'Digite sua senha atual para confirmar as alterações.';
        btn.disabled = false;
        btn.textContent = 'Salvar Alterações';
        return;
      }
      
      try {
        const response = await fetch(`/api/associados/${associadoId}/atualizar-cadastro`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        
        const result = await response.json();
        
        if (result.sucesso) {
          status.className = 'status success';
          status.textContent = 'Dados atualizados com sucesso! Redirecionando...';
          
          // Limpar senha atual do formulário
          document.getElementById('senhaAtual').value = '';
          
          // Se a senha foi alterada, limpar campos de nova senha
          if (data.novaSenha) {
            document.getElementById('novaSenha').value = '';
            document.getElementById('confirmarNovaSenha').value = '';
          }
          
          // Redirecionar para o portal após atualização bem-sucedida
          const token = localStorage.getItem('token');
          if (token) {
            window.location.href = '/portal';
          } else {
            // Se não tiver token, fazer login automático e depois redirecionar
            const senhaLogin = data.novaSenha || data.senhaAtual;
            fetch('/api/auth/login', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ cpf: cpfAssociado, senha: senhaLogin })
            })
            .then(r => r.json())
            .then(loginData => {
              if (loginData.sucesso && loginData.token) {
                localStorage.setItem('token', loginData.token);
                window.location.href = '/portal';
              } else {
                window.location.href = '/';
              }
            })
            .catch(() => {
              window.location.href = '/';
            });
          }
        } else {
          status.className = 'status error';
          status.textContent = result.erro || 'Erro ao atualizar.';
        }
      } catch (error) {
        status.className = 'status error';
        status.textContent = 'Erro de conexão. Tente novamente.';
      }
      
      btn.disabled = false;
      btn.textContent = 'Salvar Alterações';
    });
  </script>
</body>
</html>
