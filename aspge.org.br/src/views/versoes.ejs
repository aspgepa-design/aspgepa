<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Histórico de Versões - ASPGE-PA</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      padding: 40px 20px;
      color: #333;
    }
    .container {
      max-width: 800px;
      margin: 0 auto;
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      padding: 40px;
    }
    .back-link {
      display: inline-block;
      margin-bottom: 20px;
      color: #667eea;
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
    }
    .back-link:hover {
      text-decoration: underline;
    }
    .header {
      text-align: center;
      margin-bottom: 40px;
      padding-bottom: 30px;
      border-bottom: 2px solid #e5e7eb;
    }
    .header h1 {
      font-size: 28px;
      font-weight: 800;
      color: #1f2937;
      margin-bottom: 8px;
    }
    .header p {
      font-size: 14px;
      color: #6b7280;
    }
    .version {
      margin-bottom: 30px;
      padding: 24px;
      background: #f9fafb;
      border-radius: 16px;
      border-left: 4px solid #667eea;
    }
    .version-number {
      font-size: 20px;
      font-weight: 700;
      color: #667eea;
      margin-bottom: 4px;
    }
    .version-date {
      font-size: 13px;
      color: #9ca3af;
      margin-bottom: 16px;
    }
    .version h3 {
      font-size: 13px;
      font-weight: 700;
      color: #1f2937;
      margin-bottom: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .version ul {
      list-style: none;
      padding-left: 0;
    }
    .version li {
      font-size: 14px;
      color: #4b5563;
      padding: 8px 0 8px 28px;
      position: relative;
    }
    .version li::before {
      content: "•";
      color: #667eea;
      position: absolute;
      left: 0;
      font-weight: bold;
      font-size: 20px;
      line-height: 1;
    }
    .version li.added::before {
      content: "+";
      color: #10b981;
    }
    .version li.changed::before {
      content: "~";
      color: #f59e0b;
    }
    .version li.fixed::before {
      content: "✓";
      color: #3b82f6;
    }
    .footer {
      text-align: center;
      margin-top: 40px;
      padding-top: 30px;
      border-top: 2px solid #e5e7eb;
      font-size: 13px;
      color: #9ca3af;
    }
    .footer strong {
      color: #6b7280;
    }
  </style>
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#dc2626">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="ASPGE-PA">
  <link rel="apple-touch-icon" href="/public/icons/apple-touch-icon.png">
  <link rel="icon" type="image/png" href="/public/icons/icon-192.png">
</head>
<body>
  <div class="container">
    <a href="/" class="back-link">← Voltar ao Portal</a>
    
    <div class="header">
      <h1>ASPGE-PA — Histórico de Versões</h1>
      <p>Associação dos Servidores da Procuradoria Geral do Estado do Pará</p>
      <% if (versoes.length) { %>
        <p style="margin-top:8px;font-weight:600;color:#667eea">Versão atual: <%= versoes[0].versao %></p>
      <% } %>
    </div>

    <% versoes.forEach(function(v) { %>
      <div class="version">
        <div class="version-number"><%= v.versao %></div>
        <div class="version-date">
          <%= v.data %><% if (v.hash) { %> · commit <code><%= v.hash %></code><% } %>
        </div>
        <h3><%= v.titulo %></h3>
        <ul>
          <% v.itens.forEach(function(item) { %>
            <li class="<%= v.tipo %>"><%= item %></li>
          <% }); %>
        </ul>
      </div>
    <% }); %>

    <% if (marcos && marcos.length) { %>
      <div class="header" style="margin-top:10px">
        <h1 style="font-size:18px">Marcos históricos (piloto GAS)</h1>
      </div>
      <% marcos.forEach(function(v) { %>
        <div class="version" style="border-left-color:#9ca3af">
          <div class="version-number" style="color:#6b7280"><%= v.versao %></div>
          <div class="version-date"><%= v.data %></div>
          <h3><%= v.titulo %></h3>
          <ul>
            <% v.itens.forEach(function(item) { %>
              <li class="added"><%= item %></li>
            <% }); %>
          </ul>
        </div>
      <% }); %>
    <% } %>

    <div class="footer">
      <p><strong>ASPGE-PA</strong> — Associação dos Servidores da Procuradoria Geral do Estado do Pará</p>
      <p>Diretoria Executiva · <%= new Date().getFullYear() %></p>
    </div>
  </div>
<script>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', function () {
    navigator.serviceWorker.register('/sw.js').catch(function () {});
  });
}
</script>
</body>
</html>
