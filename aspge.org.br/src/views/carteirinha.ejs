<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Carteirinha Digital - ASPGE-PA</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      padding: 40px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .container {
      max-width: 600px;
      width: 100%;
      text-align: center;
    }
    .header {
      margin-bottom: 32px;
      color: #fff;
    }
    .header h1 {
      font-size: 24px;
      font-weight: 800;
      margin-bottom: 8px;
      text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    }
    .header p {
      opacity: 0.9;
    }
    .card-container {
      background: #fff;
      border-radius: 20px;
      padding: 24px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }
    .card {
      width: 100%;
      max-width: 400px;
      aspect-ratio: 85/54;
      border-radius: 16px;
      overflow: hidden;
      position: relative;
      margin: 0 auto 24px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.15);
      background: #f5f5f5;
    }
    .card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .card-side-tabs {
      display: flex;
      gap: 8px;
      justify-content: center;
      margin-bottom: 24px;
    }
    .tab-btn {
      padding: 12px 24px;
      border: none;
      background: #f3f4f6;
      color: #6b7280;
      border-radius: 10px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .tab-btn.active {
      background: linear-gradient(135deg, #667eea, #764ba2);
      color: #fff;
    }
    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      text-align: left;
      margin-bottom: 24px;
    }
    .info-item {
      padding: 12px;
      background: #f9fafb;
      border-radius: 10px;
    }
    .info-label {
      font-size: 12px;
      color: #9ca3af;
      text-transform: uppercase;
      font-weight: 600;
      margin-bottom: 4px;
    }
    .info-value {
      font-size: 15px;
      font-weight: 700;
      color: #1f2937;
    }
    .btn-download {
      width: 100%;
      padding: 16px;
      background: linear-gradient(135deg, #10b981, #059669);
      color: #fff;
      border: none;
      border-radius: 12px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .btn-download:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(16,185,129,0.4);
    }
    .back-link {
      display: inline-block;
      margin-top: 24px;
      color: #fff;
      text-decoration: none;
      font-weight: 600;
      text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    }
    .loading {
      padding: 40px;
      color: #9ca3af;
    }
    @media (max-width: 480px) {
      .info-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Carteirinha Digital</h1>
      <p>ASPGE-PA - Associação dos Servidores da PGE-PA</p>
    </div>
    
    <div class="card-container">
      <div class="card-side-tabs">
        <button class="tab-btn active" id="tabFrente" onclick="showSide('frente')">Frente</button>
        <button class="tab-btn" id="tabVerso" onclick="showSide('verso')">Verso</button>
      </div>
      
      <div id="cardFrente" class="card-content">
        <div class="card" id="cardFrenteImg">
          <img src="/public/uploads/templates/template_frente.png" alt="Carteirinha Frente" onerror="this.style.display='none'; this.parentElement.innerHTML='<div style=\'padding:40px;text-align:center;color:#999\'>Template não configurado</div>'">
        </div>
      </div>
      
      <div id="cardVerso" class="card-content" style="display:none">
        <div class="card" id="cardVersoImg">
          <img src="/public/uploads/templates/template_verso.png" alt="Carteirinha Verso" onerror="this.style.display='none'; this.parentElement.innerHTML='<div style=\'padding:40px;text-align:center;color:#999\'>Template não configurado</div>'">
        </div>
      </div>
      
      <div class="info-grid">
        <div class="info-item">
          <div class="info-label">Nome</div>
          <div class="info-value" id="infoNome">Carregando...</div>
        </div>
        <div class="info-item">
          <div class="info-label">Matrícula</div>
          <div class="info-value" id="infoMatricula">-</div>
        </div>
        <div class="info-item">
          <div class="info-label">Cargo</div>
          <div class="info-value" id="infoCargo">-</div>
        </div>
        <div class="info-item">
          <div class="info-label">Validade</div>
          <div class="info-value" id="infoValidade">-</div>
        </div>
      </div>
      
      <button class="btn-download" onclick="downloadCard()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Baixar Carteirinha
      </button>
    </div>
    
    <a href="/portal" class="back-link">← Voltar para o Portal</a>
  </div>

  <script>
    let currentSide = 'frente';
    
    // Carregar dados do usuário
    async function carregarDados() {
      const token = localStorage.getItem('token');
      if (!token) {
        window.location.href = '/';
        return;
      }
      
      try {
        const response = await fetch('/api/auth/perfil', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        
        const data = await response.json();
        
        if (data.sucesso) {
          document.getElementById('infoNome').textContent = data.dados.nomeCompleto;
          document.getElementById('infoMatricula').textContent = data.dados.matricula || 'N/A';
          document.getElementById('infoCargo').textContent = data.dados.cargo || 'N/A';
          
          // Validade: 4 anos a partir de hoje
          const hoje = new Date();
          const validade = new Date(hoje.getFullYear() + 4, hoje.getMonth(), hoje.getDate());
          document.getElementById('infoValidade').textContent = validade.toLocaleDateString('pt-BR');
        }
      } catch (error) {
        console.error('Erro ao carregar dados:', error);
      }
    }
    
    function showSide(side) {
      currentSide = side;
      
      document.getElementById('cardFrente').style.display = side === 'frente' ? 'block' : 'none';
      document.getElementById('cardVerso').style.display = side === 'verso' ? 'block' : 'none';
      
      document.getElementById('tabFrente').classList.toggle('active', side === 'frente');
      document.getElementById('tabVerso').classList.toggle('active', side === 'verso');
    }
    
    function downloadCard() {
      // TODO: Implementar download usando html2canvas ou API
      alert('Função de download em desenvolvimento. Use a função de exportação no portal.');
    }
    
    // Inicializar
    carregarDados();
  </script>
</body>
</html>
