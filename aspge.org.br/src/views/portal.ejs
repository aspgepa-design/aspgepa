// ===== NAVEGAÇÃO POR PERFIL =====
function getNav(role) {
  var nav = [];
  // Menu base para todos os perfis
  nav.push({ id: 'inicio', label: 'Início' });
  nav.push({ id: 'transparencia', label: 'Transparência' });
  nav.push({ id: 'convenios', label: 'Convênios' });
  nav.push({ id: 'votacoes', label: 'Votações' });
  nav.push({ id: 'eventos', label: 'Eventos' });
  nav.push({ id: 'atualizacao', label: 'Meu Cadastro' });
  nav.push({ id: 'dependentes', label: 'Dependentes' });
  nav.push({ id: 'documentos', label: 'Meus Documentos' });

  // Tesoureiro: + Associados
  if (role === 'tesoureiro' || role === 'diretor' || role === 'presidente') {
    nav.push({ id: 'associados_adm', label: 'Associados' });
  }

  // Diretor: + Gerir Eventos, Carteirinhas, Gerir Convênios, Gestões, Logs, Site Config, Notícias
  if (role === 'diretor' || role === 'presidente') {
    nav.push({ id: 'inscricoes_adm', label: 'Inscrições' });
    nav.push({ id: 'eventos_adm', label: 'Gerir Eventos' });
    nav.push({ id: 'carteirinhas_adm', label: 'Carteirinhas' });
    nav.push({ id: 'convenios_adm', label: 'Gerir Convênios' });
    nav.push({ id: 'gestoes_adm', label: 'Gestões' });
    nav.push({ id: 'logs_adm', label: 'Logs' });
    nav.push({ id: 'site_config_adm', label: 'Configurar Site' });
    nav.push({ id: 'noticias_adm', label: 'Notícias' });
  }

  // Tesoureiro: + Financeiro (separado)
  if (role === 'presidente' || role === 'tesoureiro') {
    nav.push({ id: 'financeiro', label: 'Financeiro' });
  }

  return nav;
}

// ===== MÁSCARAS =====
function mascaraCPF(el) {
  var v = el.value.replace(/\D/g, '').substring(0, 11);
  v = v.replace(/(\d{3})(\d)/, '$1.$2');
  v = v.replace(/(\d{3})(\d)/, '$1.$2');
  v = v.replace(/(\d{3})(\d{1,2})$/, '$1-$2');
  el.value = v;
}
function mascaraTelefone(el) {
  var v = el.value.replace(/\D/g, '').substring(0, 11);
  v = v.replace(/(\d{2})(\d)/, '($1) $2');
  v = v.replace(/(\d{5})(\d)/, '$1-$2');
  el.value = v;
}
function formatarMoeda(n) {
  return 'R$ ' + Number(n).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

// ===== LOGIN =====
function fazerLogout() {
  localStorage.removeItem('token');
  window.location.href = '/login';
}

// ===== SIDEBAR NAVIGATION =====
function montarNavegacao(role) {
  var nav = getNav(role);
  var html = '';
  for (var i = 0; i < nav.length; i++) {
    var n = nav[i];
    html += '<button class="nav-btn" data-tab="' + n.id + '" onclick="navegarPara(\'' + n.id + '\')">';
    html += '<span style="display:flex;align-items:center">' + (ICONS[n.id] || '') + '</span>';
    html += n.label + '</button>';
  }
  document.getElementById('sidebarNav').innerHTML = html;
}

function navegarPara(tabId) {
  abAtiva = tabId;
  var views = document.querySelectorAll('.view');
  for (var i = 0; i < views.length; i++) views[i].classList.remove('active');
  var view = document.getElementById('view-' + tabId);
  if (view) view.classList.add('active');
  var btns = document.querySelectorAll('.nav-btn');
  for (var j = 0; j < btns.length; j++) {
    btns[j].classList.toggle('active', btns[j].getAttribute('data-tab') === tabId);
  }
  var labels = { inicio: 'Início', transparencia: 'Transparência', convenios: 'Convênios', votacoes: 'Votações', eventos: 'Eventos',
    financeiro: 'Financeiro', atualizacao: 'Meu Cadastro', dependentes: 'Dependentes', documentos: 'Meus Documentos', associados_adm: 'Associados', inscricoes_adm: 'Inscrições', eventos_adm: 'Gerir Eventos', carteirinhas_adm: 'Carteirinhas', convenios_adm: 'Gerir Convênios', gestoes_adm: 'Gestões', logs_adm: 'Logs', site_config_adm: 'Configurar Site', noticias_adm: 'Notícias' };
  document.getElementById('headerTitle').textContent = labels[tabId] || tabId;
  if (tabId === 'inicio') dashCardFit();
  fecharMenu();
}

function toggleMenu() {
  var sb = document.querySelector('.sidebar');
  var ov = document.getElementById('sidebarOverlay');
  if (!sb) return;
  var open = sb.classList.toggle('open');
  if (ov) ov.classList.toggle('show', open);
}
function fecharMenu() {
  var sb = document.querySelector('.sidebar');
  var ov = document.getElementById('sidebarOverlay');
  if (sb) sb.classList.remove('open');
  if (ov) ov.classList.remove('show');
}

// ===== CARREGAR DADOS =====
async function carregarDadosUsuario() {
  const token = localStorage.getItem('token');
  if (!token) {
    window.location.href = '/login';
    return;
  }
  
  try {
    const response = await fetch('/api/auth/perfil', {
      headers: { 'Authorization': `Bearer ${token}` }
    });
    const data = await response.json();
    
    if (data.sucesso) {
      usuarioAtual = data.dados;
      var d = data.dados;
      
      // Verificar se cadastro está completo e senha foi alterada
      if (!d.cadastroCompleto || !d.senhaAlterada) {
        // Redirecionar para atualização cadastral
        window.location.href = '/atualizacao';
        return;
      }
      
      var ini = d.nomeCompleto ? d.nomeCompleto.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() : 'US';
      document.getElementById('userAvatar').textContent = ini;
      document.getElementById('headerAvatar').textContent = ini;
      document.getElementById('userName').textContent = d.nomeCompleto || 'Usuário';
      document.getElementById('userRole').textContent = d.cargoGestao || d.perfil || 'associado';
      
      var campos = [d.cpf, d.rg, d.matricula, d.cargo, d.whatsapp, d.email];
      var preenchidos = campos.filter(function(c) { return c && c.trim() !== '' && c.toLowerCase() !== 'não'; }).length;
      document.getElementById('dashSituacao').textContent = preenchidos + '/' + campos.length + ' campos';
      document.getElementById('dashSituacao').style.color = preenchidos === campos.length ? '#16a34a' : '#d97706';
      
      document.getElementById('atNome').value = d.nomeCompleto || '';
      document.getElementById('atCpf').value = d.cpf || '';
      document.getElementById('atRg').value = d.rg || '';
      document.getElementById('atExpeditor').value = d.expeditor || '';
      document.getElementById('atMatricula').value = d.matricula || '';
      document.getElementById('atCargo').value = d.cargo || '';
      document.getElementById('atWhatsapp').value = d.whatsapp || '';
      document.getElementById('atEmail').value = d.email || '';
      
      montarNavegacao(d.perfil || 'associado');
      navegarPara('inicio');
      carregarDadosAsync();
      myCardInit();
      dashCardInit();
    } else {
      // Token inválido/expirado ou usuário inexistente — limpar e ir para o login
      localStorage.removeItem('token');
      window.location.href = '/login';
    }
  } catch (error) {
    console.error('Erro ao carregar dados:', error);
    window.location.href = '/login';
  }
}

async function carregarDadosAsync() {
  await carregarEventos();
  await carregarConvenios();
  await carregarFinanceiro();
  await carregarVotacoes();
  await carregarDependentes();
  await carregarDocumentos();
  
  if (usuarioAtual && (usuarioAtual.perfil === 'tesoureiro' || usuarioAtual.perfil === 'diretor' || usuarioAtual.perfil === 'presidente')) {
    await carregarAssociados();
  }
  if (usuarioAtual && (usuarioAtual.perfil === 'diretor' || usuarioAtual.perfil === 'presidente')) {
    await carregarLogs();
    await carregarGestoes();
    await carregarInscricoes();
    crtCarregarConfig();
    crtCarregarLista();
    await carregarSiteConfig();
    await carregarNoticias();
  }
}

async function carregarEventos() {
  try {
    const token = localStorage.getItem('token');
    const response = await fetch('/api/eventos', {
      headers: { 'Authorization': `Bearer ${token}` }
    });
    const data = await response.json();
    if (data.sucesso && data.dados && data.dados.length > 0) {
      var html = '';
      data.dados.slice(0, 3).forEach(function(e) {
        var meses = ['JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ'];
        var dt = new Date(e.data);
        html += '<div class="evento-item"><div class="evento-data"><span class="dia">' + dt.getDate() + '</span><span class="mes">' + meses[dt.getMonth()] + '</span></div><div class="evento-info"><div class="titulo">' + e.titulo + '</div><div class="local">' + (e.local || 'Local a definir') + '</div></div></div>';
      });
      document.getElementById('dashEventos').innerHTML = html;
      // Tabela admin de eventos
      var admHtml = '<table><thead><tr><th>Data</th><th>Título</th><th>Local</th><th>Inscritos</th><th>Visível</th><th></th></tr></thead><tbody>';
      data.dados.forEach(function(e) {
        admHtml += '<tr><td>' + new Date(e.data).toLocaleDateString('pt-BR') + '</td><td style="font-weight:600">' + e.titulo + '</td><td>' + (e.local || '-') + '</td><td>' + (e.totalInscritos || 0) + '</td><td>' + (e.visivel !== false ? '✓' : '✗') + '</td><td><button class="btn btn-sm" onclick="verInscritos(' + e.id + ',\'' + String(e.titulo).replace(/'/g, "\\'") + '\')">Inscritos</button></td></tr>';
      });
      admHtml += '</tbody></table>';
      document.getElementById('eventosAdmTabela').innerHTML = admHtml;

      // Lista de eventos do membro (com inscrição)
      var memHtml = '';
      data.dados.forEach(function(e) {
        var dt = new Date(e.data);
        var btn = e.inscrito
          ? '<button class="btn btn-sm" style="background:#fee2e2;color:#b91c1c" onclick="desinscreverEvento(' + e.id + ')">Cancelar inscrição</button>'
          : '<button class="btn btn-primary btn-sm" onclick="inscreverEvento(' + e.id + ')">Confirmar presença</button>';
        memHtml += '<div class="card" style="margin-bottom:12px"><div class="card-body" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap"><div><h3 style="font-size:15px;font-weight:700;color:#1f2937">' + e.titulo + '</h3><p style="font-size:12px;color:#6b7280">' + dt.toLocaleDateString('pt-BR') + (e.horario ? ' · ' + e.horario : '') + ' · ' + (e.local || 'Local a definir') + '</p>' + (e.descricao ? '<p style="font-size:13px;color:#4b5563;margin-top:4px">' + e.descricao + '</p>' : '') + '</div><div style="text-align:right"><p style="font-size:12px;color:#6b7280;margin-bottom:6px">' + (e.totalInscritos || 0) + ' inscrito(s)</p>' + btn + '</div></div></div>';
      });
      document.getElementById('eventosList').innerHTML = memHtml || '<p style="color:#9ca3af;font-size:13px">Nenhum evento agendado.</p>';
    } else {
      document.getElementById('dashEventos').innerHTML = '<p style="color:#9ca3af;font-size:13px">Nenhum evento agendado.</p>';
      document.getElementById('eventosAdmTabela').innerHTML = '<p style="color:#9ca3af;padding:16px;text-align:center">Nenhum evento cadastrado.</p>';
      document.getElementById('eventosList').innerHTML = '<p style="color:#9ca3af;font-size:13px">Nenhum evento agendado.</p>';
    }
  } catch (error) {
    console.error('Erro ao carregar eventos:', error);
    document.getElementById('dashEventos').innerHTML = '<p style="color:#9ca3af;font-size:13px">Nenhum evento agendado.</p>';
    document.getElementById('eventosAdmTabela').innerHTML = '<p style="color:#9ca3af;padding:16px;text-align:center">Nenhum evento cadastrado.</p>';
    document.getElementById('eventosList').innerHTML = '<p style="color:#9ca3af;font-size:13px">Nenhum evento agendado.</p>';
  }
}

async function inscreverEvento(id) {
  try {
    const token = localStorage.getItem('token');
    const r = await fetch('/api/eventos/' + id + '/inscrever', { method: 'POST', headers: { 'Authorization': 'Bearer ' + token } });
    const d = await r.json();
    if (d.sucesso) { carregarEventos(); } else { alert(d.erro || 'Não foi possível se inscrever.'); }
  } catch (e) { console.error(e); alert('Erro ao se inscrever.'); }
}

async function desinscreverEvento(id) {
  try {
    if (!confirm('Cancelar sua inscrição neste evento?')) return;
    const token = localStorage.getItem('token');
    const r = await fetch('/api/eventos/' + id + '/inscrever', { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token } });
    const d = await r.json();
    if (d.sucesso) { carregarEventos(); } else { alert(d.erro || 'Não foi possível cancelar.'); }
  } catch (e) { console.error(e); alert('Erro ao cancelar inscrição.'); }
}

async function verInscritos(id, titulo) {
  try {
    const token = localStorage.getItem('token');
    const r = await fetch('/api/eventos/' + id + '/inscritos', { headers: { 'Authorization': 'Bearer ' + token } });
    const d = await r.json();
    if (!d.sucesso) { alert(d.erro || 'Erro ao carregar inscritos.'); return; }
    var linhas = d.dados.map(function(i, idx) {
      return (idx + 1) + '. ' + i.nome + ' — ' + (i.cpf || '') + (i.whatsapp ? ' — ' + i.whatsapp : '');
    }).join('\n');
    alert('Inscritos em "' + titulo + '" (' + d.total + '):\n\n' + (linhas || 'Nenhum inscrito.'));
  } catch (e) { console.error(e); alert('Erro ao carregar inscritos.'); }
}

// ===== DEPENDENTES =====
async function carregarDependentes() {
  try {
    const token = localStorage.getItem('token');
    const r = await fetch('/api/dependentes', { headers: { 'Authorization': 'Bearer ' + token } });
    const d = await r.json();
    var el = document.getElementById('dependentesTabela');
    if (!el) return;
    if (d.sucesso && d.dados && d.dados.length) {
      var html = '<table><thead><tr><th>Nome</th><th>Parentesco</th><th>Nascimento</th><th></th></tr></thead><tbody>';
      d.dados.forEach(function(dep) {
        var nasc = dep.dataNascimento ? new Date(dep.dataNascimento).toLocaleDateString('pt-BR') : '-';
        html += '<tr><td style="font-weight:600">' + dep.nome + '</td><td>' + (dep.parentesco || '-') + '</td><td>' + nasc + '</td><td><button class="btn btn-sm" style="background:#fee2e2;color:#b91c1c" onclick="excluirDependente(' + dep.id + ')">Remover</button></td></tr>';
      });
      html += '</tbody></table>';
      el.innerHTML = html;
    } else {
      el.innerHTML = '<p style="color:#9ca3af;padding:16px;text-align:center">Nenhum dependente cadastrado.</p>';
    }
  } catch (e) { console.error('Erro ao carregar dependentes:', e); }
}

async function adicionarDependente() {
  var nome = document.getElementById('depNome').value.trim();
  if (!nome) { alert('Informe o nome do dependente.'); return; }
  try {
    const token = localStorage.getItem('token');
    const r = await fetch('/api/dependentes', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
      body: JSON.stringify({
        nome: nome,
        parentesco: document.getElementById('depParentesco').value.trim(),
        dataNascimento: document.getElementById('depNascimento').value || null
      })
    });
    const d = await r.json();
    if (d.sucesso) {
      document.getElementById('depNome').value = '';
      document.getElementById('depParentesco').value = '';
      document.getElementById('depNascimento').value = '';
      carregarDependentes();
    } else { alert(d.erro || 'Erro ao adicionar.'); }
  } catch (e) { console.error(e); alert('Erro ao adicionar dependente.'); }
}

