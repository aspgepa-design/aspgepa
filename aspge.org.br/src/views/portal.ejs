    document.getElementById('finResumoTransp').innerHTML = vazioResumo;
    document.getElementById('finTabela').innerHTML = vazioTabela;
    document.getElementById('finTabelaTransp').innerHTML = vazioTabela;
  }
}

var todosAssociados = [];

async function carregarAssociados() {
  try {
    const token = localStorage.getItem('token');
    const response = await fetch('/api/associados', {
      headers: { 'Authorization': `Bearer ${token}` }
    });
    const data = await response.json();
    if (data.sucesso && data.associados) {
      todosAssociados = data.associados;
      var total = data.associados.length;
      var completo = data.associados.filter(function(a) { return a.cadastroCompleto; }).length;
      var pendente = total - completo;
      document.getElementById('statTotal').textContent = total;
      document.getElementById('statCompleto').textContent = completo;
      document.getElementById('statPendente').textContent = pendente;
      filtrarAssociados();
    }
  } catch (error) {
    console.error('Erro ao carregar associados:', error);
    document.getElementById('assocLista').innerHTML = '<p style="color:#dc2626">Erro ao carregar associados.</p>';
  }
}

function filtrarAssociados() {
  var busca = (document.getElementById('assocBusca').value || '').toLowerCase();
  var perfil = document.getElementById('assocFiltroPerfil').value;
  var mostrarInativos = document.getElementById('assocMostrarInativos').checked;
  
  var lista = todosAssociados.filter(function(a) {
    var nome = (a.nome || a.nomeCompleto || '').toLowerCase();
    var cpf = (a.cpf || '').toLowerCase();
    var cargo = (a.cargo || '').toLowerCase();
    var matchBusca = !busca || nome.includes(busca) || cpf.includes(busca) || cargo.includes(busca);
    var matchPerfil = !perfil || (a.perfil || '').toLowerCase() === perfil;
    var matchAtivo = mostrarInativos || !a.situacao || a.situacao.toLowerCase() !== 'inativo';
    return matchBusca && matchPerfil && matchAtivo;
  });

  renderizarAssociados(lista);
}

function renderizarAssociados(lista) {
  if (lista.length === 0) {
    document.getElementById('assocLista').innerHTML = '<p style="color:#9ca3af;text-align:center;padding:32px">Nenhum associado encontrado.</p>';
    return;
  }
  var html = '';
  lista.forEach(function(a) {
    var nome = a.nome || a.nomeCompleto || '';
    var ini = nome ? nome.split(' ').filter(function(n){return n.length>0;}).map(function(n){return n[0];}).join('').substring(0,2).toUpperCase() : '??';
    var cpfFormatado = a.cpf ? a.cpf.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, '$1.$2.$3-$4') : '';
    var cargoInfo = a.cargo ? a.cargo : '';
    var subInfo = cpfFormatado + (cargoInfo ? ' • ' + cargoInfo : '');
    
    var statusBadge = '';
    if (a.cadastroCompleto) {
      statusBadge = '<span style="background:#dcfce7;color:#16a34a;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700">✓ Completo</span>';
    } else {
      var campos = a.camposPreenchidos || 0;
      statusBadge = '<span style="background:#fef3c7;color:#d97706;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700">⚠ Pendente (' + campos + '/6)</span>';
    }

    var whatsBtn = '';
    if (a.cpf) {
      whatsBtn = '<button onclick="abrirWhatsAssociado(\'' + a.id + '\')" style="background:#25d366;color:#fff;border:none;padding:5px 12px;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer">Zap</button>';
    }

    html += '<div style="display:flex;align-items:center;padding:14px 16px;border-bottom:1px solid #f3f4f6;gap:14px;transition:background .15s" onmouseover="this.style.background=\'#f9fafb\'" onmouseout="this.style.background=\'transparent\'">';
    html += '<div style="width:40px;height:40px;border-radius:50%;background:#e5e7eb;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;color:#6b7280;flex-shrink:0">' + ini + '</div>';
    html += '<div style="flex:1;min-width:0"><div style="font-weight:700;font-size:14px;color:#1f2937;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">' + nome + '</div><div style="font-size:12px;color:#6b7280;margin-top:2px">' + subInfo + '</div></div>';
    html += '<div style="display:flex;align-items:center;gap:8px;flex-shrink:0">' + statusBadge + whatsBtn + '<button onclick="editarAssociado(' + a.id + ')" style="background:#1e3a5f;color:#fff;border:none;padding:5px 12px;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer">Editar</button></div>';
    html += '</div>';
  });
  document.getElementById('assocLista').innerHTML = '<div style="border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;background:#fff">' + html + '</div>';
}

function abrirWhatsAssociado(id) {
  var a = todosAssociados.find(function(x) { return x.id == id; });
  if (a && a.whatsapp) {
    var num = a.whatsapp.replace(/\D/g, '');
    if (num.length <= 11) num = '55' + num;
    window.open('https://wa.me/' + num, '_blank');
  } else {
    alert('WhatsApp não cadastrado para este associado.');
  }
}

function editarAssociado(id) {
  var a = todosAssociados.find(function(x) { return x.id == id; });
  if (!a) return alert('Associado não encontrado');
  
  // Buscar dados completos do associado
  var token = localStorage.getItem('token');
  fetch('/api/associados/' + id, { headers: { 'Authorization': 'Bearer ' + token } })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var d = data.sucesso ? data.dados : a;
      document.getElementById('editId').value = d.id || id;
      document.getElementById('editNome').value = d.nomeCompleto || d.nome || '';
      document.getElementById('editPerfil').value = d.perfil || '';
      document.getElementById('editSexo').value = d.sexo || '';
      document.getElementById('editCpf').value = d.cpf ? d.cpf.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, '$1.$2.$3-$4') : '';
      document.getElementById('editRg').value = d.rg || '';
      document.getElementById('editExpeditor').value = d.expeditor || '';
      document.getElementById('editMatricula').value = d.matricula || '';
      document.getElementById('editCargo').value = d.cargo || '';
      document.getElementById('editWhatsapp').value = d.whatsapp || '';
      document.getElementById('editEmail').value = d.email || '';
      document.getElementById('modalEditAssociado').style.display = 'flex';
    })
    .catch(function() {
      document.getElementById('editId').value = id;
      document.getElementById('editNome').value = a.nome || '';
      document.getElementById('editPerfil').value = a.perfil || '';
      document.getElementById('editSexo').value = '';
      document.getElementById('editCpf').value = a.cpf ? a.cpf.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, '$1.$2.$3-$4') : '';
      document.getElementById('editRg').value = '';
      document.getElementById('editExpeditor').value = '';
      document.getElementById('editMatricula').value = a.matricula || '';
      document.getElementById('editCargo').value = a.cargo || '';
      document.getElementById('editWhatsapp').value = a.whatsapp || '';
      document.getElementById('editEmail').value = '';
      document.getElementById('modalEditAssociado').style.display = 'flex';
    });
}

function fecharModalEdit() {
  document.getElementById('modalEditAssociado').style.display = 'none';
}

async function salvarEdicaoAssociado() {
  var id = document.getElementById('editId').value;
  var token = localStorage.getItem('token');
  var dados = {
    nomeCompleto: document.getElementById('editNome').value,
    perfil: document.getElementById('editPerfil').value,
    sexo: document.getElementById('editSexo').value,
    cpf: document.getElementById('editCpf').value.replace(/\D/g, ''),
    rg: document.getElementById('editRg').value,
    expeditor: document.getElementById('editExpeditor').value,
    matricula: document.getElementById('editMatricula').value,
    cargo: document.getElementById('editCargo').value,
    whatsapp: document.getElementById('editWhatsapp').value,
    email: document.getElementById('editEmail').value
  };

  try {
    var response = await fetch('/api/associados/' + id, {
      method: 'PUT',
      headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
      body: JSON.stringify(dados)
    });
    var result = await response.json();
    if (result.sucesso) {
      fecharModalEdit();
      carregarAssociados();
    } else {
      alert('Erro: ' + (result.erro || 'Falha ao salvar'));
    }
  } catch (e) {
    alert('Erro ao salvar: ' + e.message);
  }
}

