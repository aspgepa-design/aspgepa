        var sinal = l.tipo === 'Entrada' ? '+' : '-';
        tabelaHtml += '<tr><td style="color:#6b7280">' + new Date(l.data).toLocaleDateString('pt-BR') + '</td><td style="font-weight:600">' + l.descricao + '</td><td class="' + cls + '">' + sinal + ' ' + formatarMoeda(l.valor) + '</td><td style="color:#6b7280;font-style:italic">' + (l.responsavel || '-') + '</td></tr>';
