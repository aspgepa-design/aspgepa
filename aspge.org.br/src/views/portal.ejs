var dashCardFotoCfg = null;
var dashCardSide = 'frente';

function dashCardFit() {
  ['dashScalerFrente','dashScalerVerso'].forEach(function(sid){
    var scaler = document.getElementById(sid);
    if (!scaler || scaler.clientWidth === 0) return;
    var card = scaler.querySelector('.dc-card');
    if (!card) return;
    var scale = scaler.clientWidth / card.offsetWidth;
    card.style.transform = 'scale(' + scale + ')';
    scaler.style.height = (card.offsetHeight * scale) + 'px';
  });
  dashCardAplicarFoto();
}

function dashCardAplicarFoto() {
  var img = document.getElementById('dashPhotoImg');
  var frame = document.getElementById('dashPhotoFrame');
  if (!img || !frame || !img.src || img.style.display === 'none') return;
  var frameW = frame.offsetWidth, frameH = frame.offsetHeight;
  if (!frameW || !frameH) return;
  if (dashCardFotoCfg && img.naturalWidth) {
    var zoom = dashCardFotoCfg.zoom || 1;
    var ratio = frameW / (dashCardFotoCfg.frameW || frameW); // escala uniforme p/ não distorcer
    img.style.objectFit = '';
    img.style.width  = (img.naturalWidth  * zoom * ratio) + 'px';
    img.style.height = (img.naturalHeight * zoom * ratio) + 'px';
    img.style.left = ((dashCardFotoCfg.x || 0) * ratio) + 'px';
    img.style.top  = ((dashCardFotoCfg.y || 0) * ratio) + 'px';
  } else {
    // Sem ajuste salvo: cobre o quadro preservando a proporção (sem esticar)
    img.style.objectFit = 'cover';
    img.style.width = '100%'; img.style.height = '100%'; img.style.left = '0'; img.style.top = '0';
  }
}

function dashCardSetSide(side) {
  dashCardSide = side;
  var inner = document.getElementById('dashFlipInner');
  if (inner) inner.classList.toggle('flipped', side === 'verso');
  dashCardFit();
}
function dashCardFlip() { dashCardSetSide(dashCardSide === 'frente' ? 'verso' : 'frente'); }

