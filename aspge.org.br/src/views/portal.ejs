function myCardAtualizarTextos() {
  document.getElementById('myCardNome').textContent = document.getElementById('atNome').value || '';
  document.getElementById('myCardMatricula').textContent = document.getElementById('atMatricula').value || '';
  document.getElementById('myCardCargo').textContent = document.getElementById('atCargo').value || '';
  document.getElementById('myCardCpf').textContent = document.getElementById('atCpf').value || '';
  document.getElementById('myCardRg').textContent = document.getElementById('atRg').value || '';
}

function myCardAplicarFoto() {
  var img = document.getElementById('myPhotoImg');
  var frame = document.getElementById('myPhotoFrame');
  if (!img || !frame || !img.naturalWidth) return;
  var frameW = frame.offsetWidth, frameH = frame.offsetHeight;
  if (!frameW || !frameH) return;
  var zoom = myCardPhotoCfg.zoom || 1;
  // Escala uniforme (mesma p/ largura e altura) preserva a proporção da foto
  var ratio = frameW / (myCardPhotoCfg.frameW || frameW);
  var imgW = img.naturalWidth * zoom * ratio;
  var imgH = img.naturalHeight * zoom * ratio;
  img.style.width = imgW + 'px'; img.style.height = imgH + 'px';
  img.style.left = ((myCardPhotoCfg.x || 0) * ratio) + 'px';
  img.style.top = ((myCardPhotoCfg.y || 0) * ratio) + 'px';
}

function myCardOnFoto(input) {
  if (!input.files || !input.files[0]) return;
  var file = input.files[0];
  if (file.size > 5 * 1024 * 1024) { document.getElementById('myMsgFoto').innerHTML = '<span style="color:#dc2626">Arquivo muito grande (máx 5MB)</span>'; return; }
  myCardFotoFile = file;
  var reader = new FileReader();
  reader.onload = function(e) {
    myCardFotoBase64 = e.target.result;
    var img = document.getElementById('myPhotoImg');
    img.src = e.target.result;
    img.style.display = 'block';
    document.getElementById('myPhotoPlaceholder').style.display = 'none';
    document.getElementById('myPosControls').style.display = 'block';
    img.onload = function() {
      var frame = document.getElementById('myPhotoFrame');
      var frameW = frame.offsetWidth, frameH = frame.offsetHeight;
      var scaleW = frameW / img.naturalWidth, scaleH = frameH / img.naturalHeight;
      var zoom = Math.max(scaleW, scaleH);
      myCardPhotoCfg = { x: 0, y: 0, zoom: zoom, naturalWidth: img.naturalWidth, frameW: frameW, frameH: frameH };
      img.style.width = (img.naturalWidth * zoom) + 'px'; img.style.height = (img.naturalHeight * zoom) + 'px';
      // Centralizar
      img.style.left = ((frameW - img.naturalWidth * zoom) / 2) + 'px';
      img.style.top = ((frameH - img.naturalHeight * zoom) / 2) + 'px';
      myCardPhotoCfg.x = parseInt(img.style.left) || 0;
      myCardPhotoCfg.y = parseInt(img.style.top) || 0;
      document.getElementById('myZoomSlider').value = zoom;
      document.getElementById('myZoomLabel').textContent = Math.round(zoom * 100) + '%';
    };
  };
  reader.readAsDataURL(file);
  document.getElementById('myUploadArea').innerHTML = '<div style="font-size:32px">✅</div><p style="margin:5px 0;font-weight:600;font-size:13px">Foto carregada!</p><p style="margin:0;font-size:12px;color:#666">Clique para trocar</p>';
  document.getElementById('myMsgFoto').innerHTML = '<span style="color:#229954">Arraste a foto para ajustar a posição.</span>';
}

function myCardSetZoom(val) {
  var z = parseFloat(val); if (isNaN(z)) return;
  z = Math.max(0.1, Math.min(3, z)); // limita entre 10% e 300%
  myCardPhotoCfg.zoom = z;
  document.getElementById('myZoomSlider').value = z;
  document.getElementById('myZoomLabel').textContent = Math.round(z * 100) + '%';
  var img = document.getElementById('myPhotoImg');
  if (!img || !img.naturalWidth) return;
  var frame = document.getElementById('myPhotoFrame');
  var frameW = frame.offsetWidth, frameH = frame.offsetHeight;
  img.style.width = (img.naturalWidth * z) + 'px';
  img.style.height = (img.naturalHeight * z) + 'px';
  // Re-centralizar
  myCardPhotoCfg.x = (frameW - img.naturalWidth * z) / 2;
  myCardPhotoCfg.y = (frameH - img.naturalHeight * z) / 2;
  img.style.left = myCardPhotoCfg.x + 'px';
  img.style.top = myCardPhotoCfg.y + 'px';
}
function myCardAjustarZoom(delta) { myCardSetZoom(parseFloat(document.getElementById('myZoomSlider').value) + delta); }

function myCardMover(dx, dy) {
  var img = document.getElementById('myPhotoImg');
  if (!img || img.style.display === 'none') return;
  myCardPhotoCfg.x = (myCardPhotoCfg.x || 0) + dx;
  myCardPhotoCfg.y = (myCardPhotoCfg.y || 0) + dy;
  img.style.left = myCardPhotoCfg.x + 'px';
  img.style.top = myCardPhotoCfg.y + 'px';
}

function myCardStartDrag(e) {
  e.preventDefault();
  var img = document.getElementById('myPhotoImg');
  if (!img || img.style.display === 'none') return;
  myCardDragging = true;
  var pt = e.touches ? e.touches[0] : e;
  myCardDragStart = { x: pt.clientX, y: pt.clientY };
  myCardImgStart = { x: parseInt(img.style.left) || 0, y: parseInt(img.style.top) || 0 };
  function move(ev) {
    if (!myCardDragging) return;
    var p = ev.touches ? ev.touches[0] : ev;
    img.style.left = (myCardImgStart.x + (p.clientX - myCardDragStart.x)) + 'px';
    img.style.top = (myCardImgStart.y + (p.clientY - myCardDragStart.y)) + 'px';
  }
  function up() {
    myCardDragging = false;
    myCardPhotoCfg.x = parseInt(img.style.left) || 0;
    myCardPhotoCfg.y = parseInt(img.style.top) || 0;
    myCardPhotoCfg.frameW = document.getElementById('myPhotoFrame').offsetWidth;
    myCardPhotoCfg.frameH = document.getElementById('myPhotoFrame').offsetHeight;
    myCardPhotoCfg.naturalWidth = img.naturalWidth;
    document.removeEventListener('mousemove', move);
    document.removeEventListener('mouseup', up);
    document.removeEventListener('touchmove', move);
    document.removeEventListener('touchend', up);
  }
  document.addEventListener('mousemove', move);
  document.addEventListener('mouseup', up);
  document.addEventListener('touchmove', move);
  document.addEventListener('touchend', up);
}

async function myCardSalvar() {
  var msgEl = document.getElementById('myMsgSalvarCard');
  var btn = document.getElementById('myBtnSalvarCard'); btn.disabled = true;
  msgEl.innerHTML = '<span style="color:#2563eb">Salvando...</span>';
  var token = localStorage.getItem('token');
  try {
    var fotoUrl = usuarioAtual.fotoCarteirinhaUrl;
    if (myCardFotoFile) {
      var fd = new FormData();
      fd.append('foto', myCardFotoFile);
      fd.append('tipo', 'carteirinha');
      var upResp = await fetch('/api/associados/' + usuarioAtual.id + '/foto', {
        method: 'POST', headers: { 'Authorization': 'Bearer ' + token }, body: fd
      });
      var upData = await upResp.json();
      if (upData.sucesso && upData.url) fotoUrl = upData.url;
    }
    var dados = {
      matricula: document.getElementById('atMatricula').value,
      cargo: document.getElementById('atCargo').value,
      rg: document.getElementById('atRg').value,
      expeditor: document.getElementById('atExpeditor').value,
      whatsapp: document.getElementById('atWhatsapp').value,
      email: document.getElementById('atEmail').value,
      fotoCarteirinhaUrl: fotoUrl,
      fotoConfig: JSON.stringify(myCardPhotoCfg)
    };
    var resp = await fetch('/api/associados/' + usuarioAtual.id, {
      method: 'PUT',
      headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
      body: JSON.stringify(dados)
    });
    var r = await resp.json();
    btn.disabled = false;
    if (r.sucesso) msgEl.innerHTML = '<span style="color:#229954">Dados e foto salvos com sucesso!</span>';
    else msgEl.innerHTML = '<span style="color:#dc2626">' + (r.erro || 'Erro ao salvar') + '</span>';
  } catch(e) { btn.disabled = false; msgEl.innerHTML = '<span style="color:#dc2626">Erro: ' + e.message + '</span>'; }
}

