// ===== DOCUMENTOS =====
async function carregarDocumentos() {
  try {
    const token = localStorage.getItem('token');
    const r = await fetch('/api/documentos', { headers: { 'Authorization': 'Bearer ' + token } });
    const d = await r.json();
    var el = document.getElementById('documentosTabela');
    if (!el) return;
    if (d.sucesso && d.dados && d.dados.length) {
      var html = '<table><thead><tr><th>Nome</th><th>Tamanho</th><th>Enviado em</th><th></th></tr></thead><tbody>';
      d.dados.forEach(function(doc) {
        var tam = doc.tamanho ? (doc.tamanho / 1024).toFixed(0) + ' KB' : '-';
        var dt = doc.createdAt ? new Date(doc.createdAt).toLocaleDateString('pt-BR') : '-';
        html += '<tr><td style="font-weight:600">' + doc.nome + '</td><td>' + tam + '</td><td>' + dt + '</td><td style="white-space:nowrap"><a class="btn btn-sm" href="/api/documentos/' + doc.id + '/download?token=' + token + '" onclick="return baixarDocumento(event,' + doc.id + ')">Baixar</a> <button class="btn btn-sm" style="background:#fee2e2;color:#b91c1c" onclick="excluirDocumento(' + doc.id + ')">Excluir</button></td></tr>';
      });
      html += '</tbody></table>';
      el.innerHTML = html;
    } else {
      el.innerHTML = '<p style="color:#9ca3af;padding:16px;text-align:center">Nenhum documento enviado.</p>';
    }
  } catch (e) { console.error('Erro ao carregar documentos:', e); }
}

async function enviarDocumento() {
  var fileInput = document.getElementById('docArquivo');
  if (!fileInput.files || !fileInput.files[0]) { alert('Selecione um arquivo.'); return; }
  try {
    const token = localStorage.getItem('token');
    var fd = new FormData();
    fd.append('arquivo', fileInput.files[0]);
    fd.append('nome', document.getElementById('docNome').value.trim() || fileInput.files[0].name);
    const r = await fetch('/api/documentos', { method: 'POST', headers: { 'Authorization': 'Bearer ' + token }, body: fd });
    const d = await r.json();
    if (d.sucesso) {
      document.getElementById('docNome').value = '';
      fileInput.value = '';
      carregarDocumentos();
    } else { alert(d.erro || 'Erro ao enviar.'); }
  } catch (e) { console.error(e); alert('Erro ao enviar documento.'); }
}

async function baixarDocumento(ev, id) {
  ev.preventDefault();
  try {
    const token = localStorage.getItem('token');
    const r = await fetch('/api/documentos/' + id + '/download', { headers: { 'Authorization': 'Bearer ' + token } });
    if (!r.ok) { alert('Erro ao baixar documento.'); return false; }
    const blob = await r.blob();
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = '';
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  } catch (e) { console.error(e); alert('Erro ao baixar documento.'); }
  return false;
}

async function excluirDocumento(id) {
  if (!confirm('Excluir este documento?')) return;
  try {
    const token = localStorage.getItem('token');
    const r = await fetch('/api/documentos/' + id, { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token } });
    const d = await r.json();
    if (d.sucesso) { carregarDocumentos(); } else { alert(d.erro || 'Erro ao excluir.'); }
  } catch (e) { console.error(e); alert('Erro ao excluir documento.'); }
}

