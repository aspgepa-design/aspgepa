var crtTemplateBase64FrenteCache = null;
var crtTemplateBase64VersoCache = null;
function crtGerarPdf(carteirinhas, templateBase64Frente, templateBase64Verso) {
  crtTemplateBase64FrenteCache = templateBase64Frente;
  crtTemplateBase64VersoCache = templateBase64Verso;
  var imagens = [];
  for (var i = 0; i < carteirinhas.length; i++) {
    imagens.push({ imgBase64: null, dados: carteirinhas[i].dados, fotoBase64: carteirinhas[i].fotoBase64 });
  }
  crtMontarPdfComImagens(imagens);
}

function crtMontarPdfComImagens(imagens) {
  document.getElementById('crtBarra').style.width = '70%';
  document.getElementById('crtProgTexto').textContent = 'Gerando PDF...';
  try {
    var jsPDF = window.jspdf.jsPDF;
    var pdf = new jsPDF({ orientation:'portrait', unit:'mm', format:'a4' });
    var cW=85, cH=54, cols=2, rows=4, gapX=10, gapY=8;
    var mX=(210-cols*cW-(cols-1)*gapX)/2, mY=(297-rows*cH-(rows-1)*gapY)/2, pp=cols*rows;
    var processados = 0;
    var canvasesFrente = [];
    var canvasesVerso = [];
    var area = document.getElementById('crtPdfArea');

    function processarProxima() {
      if (processados >= imagens.length) { finalizarPdf(); return; }
      document.getElementById('crtBarra').style.width = (70 + Math.round((processados/imagens.length)*25)) + '%';
      var item = imagens[processados];
      crtRenderCard(item, area, 'frente', function(canvasFrente) {
        canvasesFrente.push(canvasFrente);
        crtRenderCard(item, area, 'verso', function(canvasVerso) {
          canvasesVerso.push(canvasVerso);
          processados++;
          processarProxima();
        });
      });
    }

    function finalizarPdf() {
      var validosFrente = canvasesFrente.filter(function(c){return c});
      var validosVerso = canvasesVerso.filter(function(c){return c});
      var totalPares = Math.min(validosFrente.length, validosVerso.length);
      var totalPaginas = 0;
      var totalBlocos = Math.ceil(totalPares / pp);
      for (var bloco = 0; bloco < totalBlocos; bloco++) {
        var inicio = bloco * pp;
        var fim = Math.min(inicio + pp, totalPares);
        if (totalPaginas > 0) pdf.addPage('a4', 'portrait');
        totalPaginas++;
        for (var i = inicio; i < fim; i++) {
          var pi = i - inicio;
          var col = pi % cols, row = Math.floor(pi / cols);
          var x = mX + col * (cW + gapX), y = mY + row * (cH + gapY);
          pdf.addImage(validosFrente[i].toDataURL('image/jpeg', 0.95), 'JPEG', x, y, cW, cH);
          pdf.setDrawColor(200); pdf.setLineWidth(0.2); pdf.rect(x, y, cW, cH);
        }
        pdf.addPage('a4', 'portrait');
        totalPaginas++;
        for (var j = inicio; j < fim; j++) {
          var pj = j - inicio;
          var col2 = pj % cols, row2 = Math.floor(pj / cols);
          var x2 = mX + col2 * (cW + gapX), y2 = mY + row2 * (cH + gapY);
          pdf.addImage(validosVerso[j].toDataURL('image/jpeg', 0.95), 'JPEG', x2, y2, cW, cH);
          pdf.setDrawColor(200); pdf.setLineWidth(0.2); pdf.rect(x2, y2, cW, cH);
        }
      }
      document.getElementById('crtBarra').style.width = '100%';
      document.getElementById('crtProgTexto').textContent = 'Concluído!';
      pdf.save('Carteirinhas_ASPGE_' + crtFormatarData(new Date()).replace(/\//g,'-') + '.pdf');
      document.getElementById('crtMsgExport').innerHTML = '<span style="color:#16a34a">PDF gerado! ' + totalPares + ' carteirinha(s) em ' + totalPaginas + ' página(s).</span>';
      document.getElementById('crtBtnPdf').disabled = false;
    }
    processarProxima();
  } catch(e) {
    document.getElementById('crtMsgExport').innerHTML = '<span style="color:#dc2626">Erro: ' + e.message + '</span>';
    document.getElementById('crtBtnPdf').disabled = false;
  }
}

function crtRenderCard(item, area, lado, callback) {
  var isFrente = (lado === 'frente');
  var fc = { left: crtFrameConfig.left, top: crtFrameConfig.top, width: crtFrameConfig.width, height: crtFrameConfig.height };
  var cc = {};
  for (var localId in crtCamposConfig) { cc[crtKeyMap[localId] || localId] = crtCamposConfig[localId]; }
  var cardW = 323, cardH = 205, scale = 2.5;
  var d = item.dados;
  var hoje = new Date(), val = new Date(hoje); val.setFullYear(val.getFullYear() + 4);
  var emStr = crtFormatarData(hoje), valStr = crtFormatarData(val);

  var div = document.createElement('div');
  div.style.cssText = 'position:relative;width:' + cardW + 'px;height:' + cardH + 'px;overflow:hidden;background:#f5f5f5';
  var bg = document.createElement('img'); bg.style.cssText = 'width:100%;height:100%;display:block';
  if (isFrente) { bg.src = crtTemplateBase64FrenteCache || crtTemplateFrenteUrl || ''; }
  else { bg.src = crtTemplateBase64VersoCache || crtTemplateVersoUrl || ''; }
  div.appendChild(bg);

  if (isFrente && item.fotoBase64) {
    var ff = document.createElement('div');
    ff.style.cssText = 'position:absolute;left:'+fc.left+'%;top:'+fc.top+'%;width:'+fc.width+'%;height:'+fc.height+'%;overflow:hidden';
    var fi = document.createElement('img'); fi.src = item.fotoBase64;
    var fCfg = null;
    try { if (d.fotoConfig) fCfg = JSON.parse(d.fotoConfig); } catch(e){}
    if (fCfg && fCfg.zoom) {
      fi.style.cssText = 'position:absolute;pointer-events:none';
      fi.setAttribute('data-fotocfg', d.fotoConfig);
    } else {
      fi.style.cssText = 'width:100%;height:100%;object-fit:cover';
    }
    ff.appendChild(fi); div.appendChild(ff);
  }

  var camposFrente = {
    cardNome: d.nomeCompleto || '', cardMatricula: d.matricula || '', cardCargo: d.cargo || '',
    cardEmissao: emStr, cardValidade: valStr,
    cardLblNome: (cc['cardLblNome'] && cc['cardLblNome'].text) || 'ASSOCIADO:',
    cardLblMatricula: (cc['cardLblMatricula'] && cc['cardLblMatricula'].text) || 'MATRÍCULA:',
    cardLblCargo: (cc['cardLblCargo'] && cc['cardLblCargo'].text) || 'CARGO:',
    cardLblEmissao: (cc['cardLblEmissao'] && cc['cardLblEmissao'].text) || 'EMISSÃO:',
    cardLblValidade: (cc['cardLblValidade'] && cc['cardLblValidade'].text) || 'VALIDADE:'
  };
  var camposVerso = {
    cardCpf: d.cpf || '', cardRg: d.rg || '',
    cardLblDadosPessoais: (cc['cardLblDadosPessoais'] && cc['cardLblDadosPessoais'].text) || 'DADOS PESSOAIS',
    cardLblCpf: (cc['cardLblCpf'] && cc['cardLblCpf'].text) || 'CPF:',
    cardLblRg: (cc['cardLblRg'] && cc['cardLblRg'].text) || 'RG:'
  };
  var campos = isFrente ? camposFrente : camposVerso;

  for (var id in campos) {
    var cfg = cc[id]; if (!cfg) continue;
    var s = document.createElement('span');
    var ws = (id === 'cardNome' || id === 'cardCargo') ? 'normal' : 'nowrap';
    var extra = (id === 'cardNome' || id === 'cardCargo') ? 'max-width:55%;line-height:1.2;' : '';
    s.style.cssText = 'position:absolute;left:'+cfg.left+'%;top:'+cfg.top+'%;font-size:'+cfg.fontSize+'mm;color:'+cfg.color+';font-weight:'+cfg.fontWeight+';font-family:Arial,Helvetica,sans-serif;white-space:'+ws+';'+extra;
    s.textContent = campos[id];
    div.appendChild(s);
  }

  area.appendChild(div);
  var imgs = div.querySelectorAll('img'), ic = imgs.length, il = 0;
  function ready() {
    il++;
    if (il >= ic) {
      var cfgImgs = div.querySelectorAll('img[data-fotocfg]');
      for (var ci = 0; ci < cfgImgs.length; ci++) {
        try {
          var cfgI = cfgImgs[ci];
          var fCfg2 = JSON.parse(cfgI.getAttribute('data-fotocfg'));
          var frameEl = cfgI.parentElement;
          var frameWpx = frameEl.offsetWidth, frameHpx = frameEl.offsetHeight;
          var zoom = fCfg2.zoom;
          if (fCfg2.naturalWidth && fCfg2.naturalWidth !== cfgI.naturalWidth) zoom = zoom * (fCfg2.naturalWidth / cfgI.naturalWidth);
          var savedFrameW = fCfg2.frameW || frameWpx;
          var savedFrameH = fCfg2.frameH || frameHpx;
          var ratio = frameWpx / savedFrameW; // escala uniforme p/ não distorcer
          cfgI.style.width = (cfgI.naturalWidth * zoom * ratio) + 'px';
          cfgI.style.height = (cfgI.naturalHeight * zoom * ratio) + 'px';
          cfgI.style.left = ((fCfg2.x || 0) * ratio) + 'px';
          cfgI.style.top = ((fCfg2.y || 0) * ratio) + 'px';
        } catch(e){}
      }
      capturar();
    }
  }
  function capturar() {
    html2canvas(div, { scale: scale, useCORS: true, allowTaint: true, backgroundColor: null })
      .then(function(canvas) { area.removeChild(div); callback(canvas); })
      .catch(function() { area.removeChild(div); callback(null); });
  }
  if (ic === 0) { capturar(); return; }
  for (var k = 0; k < imgs.length; k++) { if (imgs[k].complete) ready(); else { imgs[k].onload = ready; imgs[k].onerror = ready; } }
}

