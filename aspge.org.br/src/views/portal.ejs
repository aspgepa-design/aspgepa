    if (data.sucesso) {
      alert('Notícia publicada com sucesso!');
      document.getElementById('noticiaForm').reset();
      carregarNoticias();
    } else {
      alert('Erro ao publicar: ' + (data.erro || 'Erro desconhecido'));
    }
  } catch (error) {
    alert('Erro ao publicar notícia: ' + error.message);
  }
});

async function excluirNoticia(id) {
  if (!confirm('Tem certeza que deseja excluir esta notícia?')) return;
  const token = localStorage.getItem('token');
  try {
    const response = await fetch('/api/noticias/' + id, {
      method: 'DELETE',
      headers: { 'Authorization': `Bearer ${token}` }
    });
    const data = await response.json();
    if (data.sucesso) {
      alert('Notícia excluída com sucesso!');
      carregarNoticias();
    } else {
      alert('Erro ao excluir: ' + (data.erro || 'Erro desconhecido'));
    }
  } catch (error) {
    alert('Erro ao excluir notícia: ' + error.message);
  }
}

