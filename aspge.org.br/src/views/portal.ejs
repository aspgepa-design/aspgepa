      } else {
        gridEl.innerHTML = '<p style="color:#9ca3af;text-align:center;padding:24px">Nenhum convênio cadastrado.</p>';
      }
    }

    // Gerência: TODOS os convênios (visíveis e ocultos) para permitir editar/excluir/re-exibir
