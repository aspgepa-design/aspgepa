// ===== AJUSTE DA FOTO DO ASSOCIADO (EMISSÃO) =====
// Converte o fotoConfig salvo p/ as coords do frame de preview atual (ou cria cover-fit padrão)
function crtInitFotoCfg() {
  var img = document.getElementById('crtPhotoImg');
  var frame = document.getElementById('crtPhotoFrame');
  if (!img || !frame || !img.naturalWidth) return;
  var frameW = frame.offsetWidth, frameH = frame.offsetHeight;
  if (!frameW || !frameH) return;
  if (crtPhotoCfg && crtPhotoCfg.zoom) {
    var r = frameW / (crtPhotoCfg.frameW || frameW);
    crtPhotoCfg.zoom = (crtPhotoCfg.zoom || 1) * r;
    crtPhotoCfg.x = (crtPhotoCfg.x || 0) * r;
    crtPhotoCfg.y = (crtPhotoCfg.y || 0) * r;
  } else {
    var s = Math.max(frameW / img.naturalWidth, frameH / img.naturalHeight); // cover
    crtPhotoCfg = { zoom: s, x: (frameW - img.naturalWidth * s) / 2, y: (frameH - img.naturalHeight * s) / 2 };
  }
  crtPhotoCfg.frameW = frameW;
  crtPhotoCfg.frameH = frameH;
  crtPhotoCfg.naturalWidth = img.naturalWidth;
  crtSyncZoomUI();
}
function crtSyncZoomUI() {
  var sl = document.getElementById('crtZoomSlider');
  if (sl && crtPhotoCfg) { sl.value = crtPhotoCfg.zoom; document.getElementById('crtZoomLabel').textContent = Math.round(crtPhotoCfg.zoom * 100) + '%'; }
}
function crtAplicarFoto() {
  var img = document.getElementById('crtPhotoImg');
  if (!img || !crtPhotoCfg || !img.naturalWidth) return;
  img.style.objectFit = '';
  img.style.position = 'absolute';
  img.style.width = (img.naturalWidth * crtPhotoCfg.zoom) + 'px';
  img.style.height = (img.naturalHeight * crtPhotoCfg.zoom) + 'px';
  img.style.left = (crtPhotoCfg.x || 0) + 'px';
  img.style.top = (crtPhotoCfg.y || 0) + 'px';
}
function crtSetZoom(val) {
  var z = parseFloat(val); if (isNaN(z) || !crtPhotoCfg) return;
  crtPhotoCfg.zoom = Math.max(0.1, Math.min(3, z));
  crtSyncZoomUI();
  crtAplicarFoto();
}
function crtAjustarZoom(d) { crtSetZoom((crtPhotoCfg ? crtPhotoCfg.zoom : 1) + d); }
function crtMoverFoto(dx, dy) {
  if (!crtPhotoCfg) return;
  crtPhotoCfg.x = (crtPhotoCfg.x || 0) + dx;
  crtPhotoCfg.y = (crtPhotoCfg.y || 0) + dy;
  crtAplicarFoto();
}
function crtStartDrag(e) {
  var img = document.getElementById('crtPhotoImg');
  if (!img || img.style.display === 'none' || !crtPhotoCfg) return;
  e.preventDefault();
  crtDragging = true;
  var pt = e.touches ? e.touches[0] : e;
  crtDragStart = { x: pt.clientX, y: pt.clientY };
  crtImgStart = { x: crtPhotoCfg.x || 0, y: crtPhotoCfg.y || 0 };
  function move(ev) {
    if (!crtDragging) return;
    var p = ev.touches ? ev.touches[0] : ev;
    crtPhotoCfg.x = crtImgStart.x + (p.clientX - crtDragStart.x);
    crtPhotoCfg.y = crtImgStart.y + (p.clientY - crtDragStart.y);
    crtAplicarFoto();
  }
  function up() {
    crtDragging = false;
    document.removeEventListener('mousemove', move);
    document.removeEventListener('mouseup', up);
    document.removeEventListener('touchmove', move);
    document.removeEventListener('touchend', up);
  }
  document.addEventListener('mousemove', move);
  document.addEventListener('mouseup', up);
  document.addEventListener('touchmove', move);
  document.addEventListener('touchend', up);
}
