document.getElementById('noticiaForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const token = localStorage.getItem('token');
  const dados = {
    titulo: document.getElementById('notTitulo').value,
    descricao: document.getElementById('notDescricao').value,
    conteudo: document.getElementById('notConteudo').value,
    dataPublicacao: document.getElementById('notData').value || new Date().toISOString(),
    visivel: document.getElementById('notVisivel').checked
  };
  try {
    const response = await fetch('/api/noticias', {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      body: JSON.stringify(dados)
    });
