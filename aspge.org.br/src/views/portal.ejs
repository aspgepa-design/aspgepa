    if (data.sucesso && data.dados) {
      var html = '';
      if (data.dados.length === 0) {
        html = '<p style="color:#9ca3af;font-size:13px">Nenhuma votação cadastrada.</p>';
      } else {
        data.dados.forEach(function(v) {
          var statusCls = v.status === 'Aberta' ? 'badge-green' : 'badge-gray';
          html += '<div class="card" style="margin-bottom:12px"><div class="card-body">';
          html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px"><div><h3 style="font-size:15px;font-weight:700;color:#1f2937">' + v.titulo + '</h3><p style="font-size:12px;color:#6b7280">Encerra em: ' + (v.dataFim || 'Sem data') + '</p></div><div style="text-align:right"><span class="badge ' + statusCls + '">' + v.status + '</span><p style="font-size:12px;color:#6b7280;margin-top:4px">' + (v.totalVotos || 0) + ' votos</p></div></div>';

          // Opções de voto
          if (v.opcoes && v.opcoes.length) {
            html += '<div style="display:flex;flex-direction:column;gap:8px">';
            v.opcoes.forEach(function(o) {
              var total = v.totalVotos || 0;
              var votosOp = o._count ? o._count.votos : 0;
              var pct = total ? Math.round((votosOp / total) * 100) : 0;
              var ehMinha = v.opcaoVotada === o.id;
              if (v.status === 'Aberta' && !v.jaVotou) {
                html += '<button class="btn btn-sm" style="text-align:left;border:1px solid #d1d5db;background:#fff" onclick="votar(' + v.id + ',' + o.id + ',this)">' + o.texto + '</button>';
              } else {
                html += '<div style="border:1px solid ' + (ehMinha ? '#2563eb' : '#e5e7eb') + ';border-radius:6px;padding:8px 10px;background:' + (ehMinha ? '#eff6ff' : '#f9fafb') + '"><div style="display:flex;justify-content:space-between;font-size:13px"><span style="font-weight:' + (ehMinha ? '700' : '500') + '">' + o.texto + (ehMinha ? ' ✓' : '') + '</span><span style="color:#6b7280">' + votosOp + ' (' + pct + '%)</span></div><div style="height:6px;background:#e5e7eb;border-radius:3px;margin-top:6px"><div style="height:100%;width:' + pct + '%;background:' + (ehMinha ? '#2563eb' : '#9ca3af') + ';border-radius:3px"></div></div></div>';
              }
            });
            html += '</div>';
          }
          if (v.jaVotou) {
            html += '<p style="font-size:12px;color:#059669;margin-top:8px">✓ Você já votou nesta votação.</p>';
          }
          html += '</div></div>';
        });
      }
      document.getElementById('votacoesList').innerHTML = html;
    }
  } catch (error) {
    console.error('Erro ao carregar votações:', error);
  }
}

async function votar(votacaoId, opcaoId, btn) {
  try {
    if (!confirm('Confirmar seu voto? Esta ação não pode ser desfeita.')) return;
    const token = localStorage.getItem('token');
    const response = await fetch('/api/votacoes/' + votacaoId + '/votar', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
      body: JSON.stringify({ opcaoId: opcaoId })
    });
    const data = await response.json();
    if (data.sucesso) {
      carregarVotacoes();
    } else {
      alert(data.erro || 'Não foi possível registrar o voto.');
    }
  } catch (error) {
    console.error('Erro ao votar:', error);
    alert('Erro ao registrar voto.');
  }
}

async function carregarGestoes() {
  try {
    const token = localStorage.getItem('token');
    const response = await fetch('/api/gestoes', {
      headers: { 'Authorization': `Bearer ${token}` }
    });
    const data = await response.json();
    if (data.sucesso && data.dados && data.dados.length > 0) {
      var html = '';
      data.dados.forEach(function(g) {
        var ativaCls = g.ativa ? 'badge-green' : 'badge-gray';
        var membrosHtml = '';
        if (g.membros && g.membros.length > 0) {
          membrosHtml = '<div style="margin-top:12px;border-top:1px solid #e5e7eb;padding-top:12px"><p style="font-size:12px;font-weight:700;color:#6b7280;margin-bottom:8px">DIRETORIA:</p>';
          g.membros.forEach(function(m) {
            membrosHtml += '<div style="display:flex;justify-content:space-between;padding:4px 0;font-size:13px"><span style="font-weight:600">' + m.nome + '</span><span style="color:#6b7280">' + m.cargo + '</span></div>';
          });
          membrosHtml += '</div>';
        }
        html += '<div class="card" style="margin-bottom:16px"><div class="card-body"><div style="display:flex;justify-content:space-between;align-items:center"><div><h3 style="font-size:16px;font-weight:700">' + g.nome + '</h3><p style="font-size:12px;color:#6b7280">Início: ' + (g.inicio ? new Date(g.inicio).toLocaleDateString('pt-BR') : '-') + ' | Fim: ' + (g.fim ? new Date(g.fim).toLocaleDateString('pt-BR') : '-') + '</p></div><span class="badge ' + ativaCls + '">' + (g.ativa ? 'Ativa' : 'Inativa') + '</span></div>' + membrosHtml + '</div></div>';
      });
      document.getElementById('gestoesContent').innerHTML = html;
    } else {
      document.getElementById('gestoesContent').innerHTML = '<p style="color:#9ca3af;padding:16px;text-align:center">Nenhuma gestão cadastrada.</p>';
