<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Portal do Associado - ASPGE-PA</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
/* ===== RESET & BASE ===== */
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%;width:100%;font-family:'Inter',system-ui,-apple-system,sans-serif;background:#f8fafc;color:#1f2937;overflow:hidden}

/* ===== APP LAYOUT ===== */
.app{display:flex;flex-direction:column;height:100vh;width:100%}
.app-body{display:flex;flex:1;min-height:0;overflow:hidden}

/* ===== SIDEBAR ===== */
.sidebar{width:256px;background:#fff;border-right:1px solid #e5e7eb;display:flex;flex-direction:column;flex-shrink:0;overflow-y:auto}
.sidebar-brand{padding:24px 24px 16px;display:flex;align-items:center;gap:12px}
.sidebar-logo{width:36px;height:36px;background:linear-gradient(135deg,#dc2626,#0075bf);border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:12px}
.sidebar-name{font-weight:900;color:#1e3a5f;letter-spacing:-.5px;font-size:15px}
.sidebar-nav{flex:1;padding:0 12px}
.nav-btn{width:100%;display:flex;align-items:center;gap:12px;padding:12px 16px;border-radius:12px;border:none;background:transparent;color:#9ca3af;font-weight:700;font-size:13px;cursor:pointer;transition:.2s;text-align:left}
.nav-btn:hover{background:#f9fafb;color:#4b5563}
.nav-btn.active{background:#eff6ff;color:#0075bf;box-shadow:0 1px 3px rgba(0,117,191,.08)}
.nav-btn svg{width:18px;height:18px;flex-shrink:0}
.sidebar-user{padding:16px;margin-top:auto}
.user-card{background:#f9fafb;padding:16px;border-radius:16px;border:1px solid #f3f4f6}
.user-info{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.user-avatar{width:40px;height:40px;background:linear-gradient(135deg,#16a34a,#0075bf);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:12px;box-shadow:0 4px 12px rgba(0,117,191,.25)}
.user-name{font-size:12px;font-weight:700;color:#1f2937}
.user-role{font-size:10px;color:#6b7280;text-transform:capitalize}
.logout-btn{width:100%;display:flex;align-items:center;justify-content:center;gap:8px;padding:10px;border:none;background:transparent;color:#dc2626;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;cursor:pointer;border-radius:8px;transition:.2s}
.logout-btn:hover{background:#fef2f2}

/* ===== HEADER ===== */
.header{background:rgba(255,255,255,.85);backdrop-filter:blur(12px);padding:16px 32px;border-bottom:1px solid #e5e7eb;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:10}
.header h1{font-size:20px;font-weight:900;color:#111827;text-transform:capitalize}
.header-right{display:flex;align-items:center;gap:16px}
.header-avatar{width:40px;height:40px;background:linear-gradient(135deg,#dc2626,#0075bf);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:13px;border:2px solid #fff;box-shadow:0 4px 12px rgba(0,0,0,.1)}
.header-left{display:flex;align-items:center;gap:12px;min-width:0}
.menu-btn{display:none;background:none;border:none;color:#1f2937;cursor:pointer;padding:6px;border-radius:8px;line-height:1;align-items:center;justify-content:center}
.menu-btn:hover{background:#f3f4f6}
.sidebar-overlay{display:none}

/* ===== MAIN CONTENT ===== */
.main{flex:1;display:flex;flex-direction:column;min-width:0;overflow:hidden}
.content{flex:1;overflow-y:auto;padding:24px 32px}
.view{display:none;animation:fadeIn .4s ease}
.view.active{display:block}

/* ===== COMPONENTS: CARDS ===== */
.card{background:#fff;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.06);border:1px solid #e5e7eb;overflow:hidden}
.card-header{padding:16px 24px;border-bottom:1px solid #f3f4f6;background:rgba(249,250,251,.5)}
.card-header h3{font-size:16px;font-weight:700;color:#1f2937}
.card-header p{font-size:13px;color:#6b7280}
.card-body{padding:24px}

/* ===== COMPONENTS: BADGE ===== */
.badge{display:inline-block;font-size:10px;padding:2px 10px;border-radius:99px;font-weight:700;text-transform:uppercase;letter-spacing:.5px}
.badge-blue{background:#dbeafe;color:#1d4ed8}
.badge-green{background:#dcfce7;color:#15803d}
.badge-red{background:#fee2e2;color:#dc2626}
.badge-yellow{background:#fef9c3;color:#a16207}
.badge-gray{background:#f3f4f6;color:#4b5563}

/* ===== COMPONENTS: BUTTONS ===== */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:8px 16px;border-radius:8px;border:none;font-weight:600;font-size:14px;cursor:pointer;transition:.2s}
.btn-sm{padding:6px 12px;font-size:12px}
.btn-primary{background:#0075bf;color:#fff}.btn-primary:hover{background:#005a91}
.btn-success{background:#16a34a;color:#fff}.btn-success:hover{background:#15803d}
.btn-danger{background:#dc2626;color:#fff}.btn-danger:hover{background:#b91c1c}
.btn-outline{background:transparent;border:1px solid #0075bf;color:#0075bf}.btn-outline:hover{background:#eff6ff}
.btn:disabled{opacity:.5;cursor:not-allowed}

/* ===== COMPONENTS: TABLE ===== */
.table-wrap{overflow-x:auto;width:100%}
table{width:100%;text-align:left;font-size:13px;border-collapse:collapse}
thead tr{border-bottom:1px solid #e5e7eb}
th{padding:12px 16px;color:#9ca3af;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px}
td{padding:12px 16px}
tbody tr{border-bottom:1px solid #f3f4f6;transition:.15s}
tbody tr:hover{background:#f9fafb}

/* ===== DASHBOARD: CARTEIRA ===== */
/* Carteirinha digital (flip frente/verso) no Início — renderizada em CR80 e escalada p/ caber */
.dc-scaler{width:100%;position:relative}
.dc-flip-scene{perspective:1200px}
.dc-flip-inner{position:relative;width:100%;cursor:pointer;transform-style:preserve-3d;transition:transform .6s cubic-bezier(.4,0,.2,1);-webkit-tap-highlight-color:transparent}
.dc-flip-inner.flipped{transform:rotateY(180deg)}
.dc-flip-face{backface-visibility:hidden;-webkit-backface-visibility:hidden}
.dc-flip-back{position:absolute;top:0;left:0;width:100%;height:100%;transform:rotateY(180deg)}
.dc-card{width:85.6mm;height:53.98mm;position:relative;overflow:hidden;border-radius:4mm;background:#e5e7eb;transform-origin:top left;box-shadow:0 12px 32px rgba(0,0,0,.35)}
.dc-bg{position:absolute;top:0;left:0;width:100%;height:100%;display:block}
.dc-photo{position:absolute;overflow:hidden;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.5)}
.dc-photo img{position:absolute}
.dc-ov{position:absolute;white-space:nowrap;line-height:1;font-family:'Inter',sans-serif}
#dashCardNome,#dashCardCargo{white-space:normal;max-width:55%;line-height:1.2}
.dc-no-template{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#6b7280;font-size:4mm;padding:4mm;text-align:center}
.dc-hint{color:#6b7280;font-size:12px;margin-top:12px;text-align:center}
.dc-loading{padding:40px 16px;color:#6b7280;font-size:14px;text-align:center}

/* ===== DASHBOARD: WIDGETS ===== */
.widgets-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.widget-stat{display:flex;flex-direction:column;justify-content:center}
.widget-stat .label{color:#6b7280;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px}
.widget-stat .value{font-size:32px;font-weight:900;color:#1f2937;margin-top:4px}
.widget-stat .sub{font-size:10px;color:#16a34a;background:#dcfce7;display:inline-block;padding:2px 8px;border-radius:4px;font-weight:700;margin-top:4px}
.widget-stat .sub-gray{font-size:11px;color:#9ca3af;font-style:italic}
.border-l-blue{border-left:4px solid #3b82f6}
.border-l-green{border-left:4px solid #10b981}

/* ===== DASHBOARD: EVENTOS ===== */
.evento-item{display:flex;align-items:center;gap:16px;padding:12px;background:#eff6ff;border-radius:12px;border:1px solid #dbeafe}
.evento-data{background:#fff;padding:8px;border-radius:8px;box-shadow:0 1px 3px rgba(0,0,0,.06);text-align:center;min-width:50px}
.evento-data .dia{display:block;font-weight:900;color:#1e3a5f;font-size:20px}
.evento-data .mes{display:block;font-size:9px;text-transform:uppercase;color:#6b7280;font-weight:700}
.evento-info .titulo{font-weight:700;color:#1e3a5f;font-size:14px}
.evento-info .local{font-size:11px;color:#6b7280}

/* ===== FINANCEIRO: RESUMO ===== */
.fin-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px}
.fin-card{padding:24px;border-radius:16px;color:#fff;box-shadow:0 8px 24px rgba(0,0,0,.15)}
.fin-card.receitas{background:#16a34a}
.fin-card.despesas{background:#dc2626}
.fin-card.saldo{background:#1e3a5f}
.fin-card .fin-label{font-size:11px;font-weight:700;text-transform:uppercase;opacity:.75}
.fin-card .fin-valor{font-size:28px;font-weight:900;margin-top:4px}
.valor-positivo{color:#16a34a;font-weight:700}
.valor-negativo{color:#dc2626;font-weight:700}

/* ===== CONVENIOS ===== */
.convenios-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:24px}
.convenio-card .icon-area{height:100px;background:#f3f4f6;border-radius:8px;margin-bottom:16px;display:flex;align-items:center;justify-content:center;color:#d1d5db;font-size:40px}
.convenio-card h3{font-size:16px;font-weight:700;margin-top:8px;color:#1f2937}
.convenio-card .desc{font-size:12px;color:#6b7280;margin:6px 0 16px;min-height:40px;display:-webkit-box;-webkit-line-clamp:3;line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.convenio-actions{display:flex;gap:8px}
.convenio-actions .btn{flex:1}

/* ===== ANIMATIONS ===== */
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@keyframes spin{to{transform:rotate(360deg)}}

/* ===== RESPONSIVE ===== */
/* Telas médias/tablets: carteirinha empilhada acima dos widgets e centralizada */
@media(max-width:992px){
  .dashboard-grid{grid-template-columns:1fr !important}
  .dc-flip-scene{max-width:440px;margin:0 auto}
}
@media(max-width:768px){
  .sidebar{position:fixed;left:-280px;top:0;bottom:0;z-index:50;transition:left .3s ease;box-shadow:4px 0 24px rgba(0,0,0,.1)}
  .sidebar.open{left:0}
  .content{padding:16px}
  .fin-grid{grid-template-columns:1fr}
  .widgets-grid{grid-template-columns:1fr}
  .header{padding:12px 16px}
  .header h1{font-size:16px}
  .card-body{padding:16px}
  .widget-stat .value{font-size:26px}
  .menu-btn{display:inline-flex}
  .sidebar-overlay{display:block;position:fixed;inset:0;background:rgba(17,24,39,.45);z-index:45;opacity:0;pointer-events:none;transition:opacity .25s}
  .sidebar-overlay.show{opacity:1;pointer-events:auto}
}
@media(max-width:480px){
  .content{padding:12px}
  .card-body{padding:14px}
  .widget-stat .value{font-size:22px}
  .widget-stat .label{font-size:10px}
}

/* ===== LOADING ===== */
.spinner{display:inline-block;width:20px;height:20px;border:3px solid #e5e7eb;border-top-color:#2563eb;border-radius:50%;animation:spin .6s linear infinite}
.loading-overlay{display:flex;align-items:center;justify-content:center;padding:60px;color:#6b7280;gap:12px;font-size:14px}
/* ===== CARTEIRINHA CONFIG ===== */
.crt-overlay{position:absolute;font-family:Arial,Helvetica,sans-serif;color:#1a1a1a;font-weight:700;white-space:nowrap;pointer-events:none;user-select:none}
#crtNome,#crtCargo{white-space:normal;max-width:55%;line-height:1.2}
.crt-ctrl{display:flex;align-items:center;gap:6px}.crt-ctrl label{min-width:32px;font-size:11px;font-weight:600;color:#555;margin:0;text-transform:uppercase}
.crt-ctrl input[type="range"]{flex:1;padding:0;border:none;height:5px;-webkit-appearance:none;background:#dee2e6;border-radius:3px}
.crt-ctrl input[type="range"]::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;border-radius:50%;background:#0075bf;cursor:pointer}
.crt-ctrl input[type="range"]:focus{box-shadow:none}
.crt-val{width:58px;padding:2px 4px;border:1px solid #dee2e6;border-radius:4px;font-size:11px;color:#374151;font-family:monospace;text-align:center;background:#fff}
.crt-val:focus{border-color:#0075bf;outline:none;box-shadow:0 0 0 2px rgba(0,117,191,.15)}
.crt-campo-hl{outline:2px dashed #ff6600!important;outline-offset:2px}
</style>
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#dc2626">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="ASPGE-PA">
<link rel="apple-touch-icon" href="/public/icons/apple-touch-icon.png">
<link rel="icon" type="image/png" href="/public/icons/icon-192.png">
</head>
<body>

<!-- APP SCREEN -->
<div class="app">
  <div class="app-body">
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="fecharMenu()"></div>
    <!-- SIDEBAR -->
    <aside class="sidebar">
      <div class="sidebar-brand">
        <div class="sidebar-logo">ASP</div>
        <span class="sidebar-name">ASPGE-PA</span>
      </div>
      <nav class="sidebar-nav" id="sidebarNav">
        <!-- Preenchido via JS -->
      </nav>
      <div class="sidebar-user">
        <div class="user-card">
          <div class="user-info">
            <div class="user-avatar" id="userAvatar">US</div>
            <div>
              <p class="user-name" id="userName">Carregando...</p>
              <p class="user-role" id="userRole">associado</p>
            </div>
          </div>
          <button class="logout-btn" onclick="fazerLogout()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Sair
          </button>
        </div>
        <div style="text-align:center;margin-top:12px">
          <a href="/versoes" style="font-size:11px;color:#9ca3af;text-decoration:none">Versão <%= (typeof versaoAtual !== 'undefined' && versaoAtual ? versaoAtual : 'v2.0.0').replace(/^v/, '') %></a>
        </div>
      </div>
    </aside>

    <!-- MAIN -->
    <div class="main">
      <!-- HEADER -->
      <header class="header">
        <div class="header-left">
          <button class="menu-btn" id="menuBtn" onclick="toggleMenu()" aria-label="Abrir menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          </button>
          <h1 id="headerTitle">Início</h1>
        </div>
        <div class="header-right">
          <div class="header-avatar" id="headerAvatar">US</div>
        </div>
      </header>

      <!-- CONTENT -->
      <div class="content">

        <!-- ===== VIEW: INÍCIO/DASHBOARD ===== -->
        <div id="view-inicio" class="view active">
          <div style="display:grid;grid-template-columns:1fr 2fr;gap:24px" class="dashboard-grid">
            <!-- Carteirinha Digital (toque para virar) -->
            <div>
              <div class="dc-flip-scene">
                <div class="dc-flip-inner" id="dashFlipInner" onclick="dashCardFlip()" role="button" aria-label="Virar carteirinha">
                  <div class="dc-scaler dc-flip-face" id="dashScalerFrente">
                    <div class="dc-card" id="dashCardFrente">
                      <img id="dashBgFrente" class="dc-bg" alt="">
                      <div id="dashPhotoFrame" class="dc-photo"><img id="dashPhotoImg" alt=""></div>
                      <span class="dc-ov" id="dashCardLblNome">ASSOCIADO:</span>
                      <span class="dc-ov" id="dashCardNome"></span>
                      <span class="dc-ov" id="dashCardLblMatricula">MATRÍCULA:</span>
                      <span class="dc-ov" id="dashCardMatricula"></span>
                      <span class="dc-ov" id="dashCardLblCargo">CARGO:</span>
                      <span class="dc-ov" id="dashCardCargo"></span>
                      <span class="dc-ov" id="dashCardLblEmissao">EMISSÃO:</span>
                      <span class="dc-ov" id="dashCardEmissao"></span>
                      <span class="dc-ov" id="dashCardLblValidade">VALIDADE:</span>
                      <span class="dc-ov" id="dashCardValidade"></span>
                    </div>
                  </div>
                  <div class="dc-scaler dc-flip-face dc-flip-back" id="dashScalerVerso">
                    <div class="dc-card" id="dashCardVerso">
                      <img id="dashBgVerso" class="dc-bg" alt="">
                      <span class="dc-ov" id="dashCardLblDadosPessoais">DADOS PESSOAIS</span>
                      <span class="dc-ov" id="dashCardLblCpf">CPF:</span>
                      <span class="dc-ov" id="dashCardCpf"></span>
                      <span class="dc-ov" id="dashCardLblRg">RG:</span>
                      <span class="dc-ov" id="dashCardRg"></span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="dc-loading" id="dashCardLoading">Carregando carteirinha…</div>
              <p class="dc-hint">Toque na carteirinha para virar</p>
            </div>

            <!-- Widgets -->
            <div>
              <div class="widgets-grid">
                <div class="card widget-stat border-l-blue">
                  <div class="card-body">
                    <p class="label">Convênios Disponíveis</p>
                    <span class="value" id="dashConvenios">--</span>
                    <span class="sub">Parceiros ativos</span>
                  </div>
                </div>
                <div class="card widget-stat border-l-green">
                  <div class="card-body">
                    <p class="label">Situação Cadastral</p>
                    <span class="value" style="font-size:20px" id="dashSituacao">--</span>
                    <span class="sub-gray">Dados na planilha</span>
                  </div>
                </div>
                <div class="card" style="grid-column:span 2">
                  <div class="card-body">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                      <h4 style="font-weight:700;display:flex;align-items:center;gap:8px">📅 Próximos Eventos</h4>
                    </div>
                    <div id="dashEventos">
                      <div class="loading-overlay" style="padding:16px"><div class="spinner"></div> Carregando...</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Link rápido para atualização -->
          <div class="card" style="margin-top:24px;border-left:4px solid #f59e0b">
            <div class="card-body" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px">
              <div>
                <h4 style="font-weight:700;color:#92400e">📋 Seus dados estão completos?</h4>
                <p style="font-size:13px;color:#6b7280">Verifique e atualize seu cadastro para manter tudo em dia.</p>
              </div>
              <button class="btn btn-primary btn-sm" onclick="navegarPara('atualizacao')">Atualizar Cadastro</button>
            </div>
          </div>
        </div>

        <!-- ===== VIEW: TRANSPARÊNCIA ===== -->
        <div id="view-transparencia" class="view">
          <div style="margin-bottom:24px">
            <h2 style="font-size:22px;font-weight:900;color:#1f2937">Transparência Financeira</h2>
            <p style="font-size:13px;color:#6b7280">Prestação de contas da associação.</p>
          </div>
          <div class="fin-grid" id="finResumoTransp">
            <div class="loading-overlay"><div class="spinner"></div> Carregando...</div>
          </div>
          <div class="card">
            <div class="card-header"><h3>Movimentações</h3></div>
            <div class="card-body">
              <div class="table-wrap" id="finTabelaTransp">
                <div class="loading-overlay"><div class="spinner"></div> Carregando...</div>
              </div>
            </div>
          </div>
        </div>

        <!-- ===== VIEW: FINANCEIRO (Tesoureiro) ===== -->
        <div id="view-financeiro" class="view">
          <header style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;margin-bottom:24px">
            <div>
              <h2 style="font-size:22px;font-weight:900;color:#1f2937">Gestão de Tesouraria</h2>
              <p style="font-size:13px;color:#6b7280">Controle de entradas, saídas e prestação de contas.</p>
            </div>
            <div style="display:flex;gap:8px">
              <button class="btn btn-success btn-sm" onclick="abrirModalLanc('Entrada')">+ Entrada</button>
              <button class="btn btn-danger btn-sm" onclick="abrirModalLanc('Saída')">+ Saída</button>
            </div>
          </header>
          <div class="fin-grid" id="finResumo">
            <div class="loading-overlay"><div class="spinner"></div> Carregando...</div>
          </div>
          <div class="card">
            <div class="card-header"><h3>Últimas Movimentações</h3></div>
            <div class="card-body">
              <div class="table-wrap" id="finTabela">
                <div class="loading-overlay"><div class="spinner"></div> Carregando...</div>
              </div>
            </div>
          </div>
        </div>

        <!-- ===== VIEW: CONVÊNIOS ===== -->
        <div id="view-convenios" class="view">
