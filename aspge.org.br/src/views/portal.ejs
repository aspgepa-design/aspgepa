      document.getElementById('finResumoTransp').innerHTML = resumoHtml;
      
      var tabelaHtml = '<table><thead><tr><th>Data</th><th>Descrição</th><th>Valor</th><th>Responsável</th></tr></thead><tbody>';
      data.dados.forEach(function(l) {
