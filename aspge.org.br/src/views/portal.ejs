// ===== CONVÊNIOS: CRUD =====
var convenioEditandoId = null;
var conveniosDataCache = [];

function abrirModalConvenio(id) {
  convenioEditandoId = id || null;
  document.getElementById('modalConvenio').style.display = 'flex';
  document.getElementById('modalConvenioTitle').textContent = id ? '✏️ Editar Convênio' : '➕ Novo Convênio';
  if (!id) {
    document.getElementById('convNome').value = '';
    document.getElementById('convDescricao').value = '';
    document.getElementById('convCategoria').value = '';
    document.getElementById('convLink').value = '';
    document.getElementById('convVisivel').checked = true;
  } else {
    var c = conveniosDataCache.find(function(x) { return x.id === id; });
    if (c) {
      document.getElementById('convNome').value = c.nome || '';
      document.getElementById('convDescricao').value = c.descricao || '';
      document.getElementById('convCategoria').value = c.categoria || '';
      document.getElementById('convLink').value = c.link || '';
      document.getElementById('convVisivel').checked = c.visivel !== false;
    }
  }
}

function fecharModalConvenio() {
  document.getElementById('modalConvenio').style.display = 'none';
  convenioEditandoId = null;
}

async function salvarConvenio() {
  var token = localStorage.getItem('token');
  var dados = {
    nome: document.getElementById('convNome').value.trim(),
    descricao: document.getElementById('convDescricao').value.trim(),
    categoria: document.getElementById('convCategoria').value.trim(),
    link: document.getElementById('convLink').value.trim(),
    visivel: document.getElementById('convVisivel').checked
  };
  if (!dados.nome) { alert('Nome do convênio é obrigatório'); return; }

  var url = convenioEditandoId ? '/api/convenios/' + convenioEditandoId : '/api/convenios';
  var method = convenioEditandoId ? 'PUT' : 'POST';

  try {
    var response = await fetch(url, {
      method: method,
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
      body: JSON.stringify(dados)
    });
    var result = await response.json();
    if (result.sucesso) {
      fecharModalConvenio();
      carregarConvenios();
    } else {
      alert(result.erro || 'Erro ao salvar convênio');
    }
  } catch (error) {
    alert('Erro de conexão');
  }
}

function editarConvenio(id) {
  abrirModalConvenio(id);
}

async function excluirConvenio(id) {
  if (!confirm('Tem certeza que deseja excluir este convênio?')) return;
  var token = localStorage.getItem('token');
  try {
    var response = await fetch('/api/convenios/' + id, {
      method: 'DELETE',
      headers: { 'Authorization': 'Bearer ' + token }
    });
