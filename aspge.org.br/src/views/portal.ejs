      document.getElementById('finResumo').innerHTML = vazioResumo;
      document.getElementById('finResumoTransp').innerHTML = vazioResumo;
      document.getElementById('finTabela').innerHTML = vazioTabela;
      document.getElementById('finTabelaTransp').innerHTML = vazioTabela;
