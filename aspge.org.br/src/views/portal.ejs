function crtSyncFromRange(rangeId, numId) {
  document.getElementById(numId).value = parseFloat(document.getElementById(rangeId).value).toFixed(1);
}
function crtSyncFromNum(numId, rangeId) {
  var v = parseFloat(document.getElementById(numId).value);
  if (isNaN(v)) return;
  var r = document.getElementById(rangeId);
  v = Math.max(parseFloat(r.min), Math.min(parseFloat(r.max), v));
  r.value = v; document.getElementById(numId).value = v.toFixed(1);
}
function crtSyncFrameFromRange(rangeId, numId, prop) {
  var val = parseFloat(document.getElementById(rangeId).value);
  document.getElementById(numId).value = val.toFixed(1);
  crtFrameConfig[prop] = val;
  crtAplicarFrame();
}
function crtSyncFrameFromNum(numId, rangeId, prop) {
  var v = parseFloat(document.getElementById(numId).value);
  if (isNaN(v)) return;
  var r = document.getElementById(rangeId);
  v = Math.max(parseFloat(r.min), Math.min(parseFloat(r.max), v));
  r.value = v; document.getElementById(numId).value = v.toFixed(1);
  crtFrameConfig[prop] = v;
  crtAplicarFrame();
}

async function crtCarregarConfig() {
  try {
    var token = localStorage.getItem('token');
    var resp = await fetch('/api/carteirinhas/config', { headers: { 'Authorization': 'Bearer ' + token } });
    var r = await resp.json();
    if (r && r.config) {
      try {
        var cfg = JSON.parse(r.config);
        if (cfg.frame) crtFrameConfig = cfg.frame;
        if (cfg.campos) {
          for (var savedId in cfg.campos) {
            var localId = crtKeyMapInv[savedId];
            if (localId && crtCamposConfig[localId]) crtCamposConfig[localId] = cfg.campos[savedId];
          }
        }
      } catch(e){}
    }
    if (r && r.templateFrente) {
      crtTemplateFrenteUrl = r.templateFrente;
      document.getElementById('crtBg').src = r.templateFrente;
    }
    if (r && r.templateVerso) {
      crtTemplateVersoUrl = r.templateVerso;
      document.getElementById('crtBgVerso').src = r.templateVerso;
    }
    crtAplicarFrame();
    crtSincronizarFrameUI();
    crtAplicarTodosCampos();
    crtSelecionarCampo('crtNome');
  } catch(e) { console.error('Erro ao carregar config carteirinha:', e); }
}

function crtAplicarFrame() {
  var f = document.getElementById('crtPhotoFrame');
  if (!f) return;
  f.style.left = crtFrameConfig.left + '%';
  f.style.top = crtFrameConfig.top + '%';
  f.style.width = crtFrameConfig.width + '%';
  f.style.height = crtFrameConfig.height + '%';
  crtRebaseFoto(); // mantém a foto proporcional ao novo tamanho do frame
}
// Rebase da foto p/ o tamanho atual do frame (chamado ao redimensionar o enquadramento)
function crtRebaseFoto() {
  var img = document.getElementById('crtPhotoImg');
  var frame = document.getElementById('crtPhotoFrame');
  if (!crtPhotoCfg || !img || !frame || !img.naturalWidth || img.style.display === 'none') return;
  var frameW = frame.offsetWidth, frameH = frame.offsetHeight;
  if (!frameW || !frameH) return;
  var r = frameW / (crtPhotoCfg.frameW || frameW);
  if (Math.abs(r - 1) < 0.001) return;
  crtPhotoCfg.zoom *= r;
  crtPhotoCfg.x = (crtPhotoCfg.x || 0) * r;
  crtPhotoCfg.y = (crtPhotoCfg.y || 0) * r;
  crtPhotoCfg.frameW = frameW;
  crtPhotoCfg.frameH = frameH;
  crtAplicarFoto();
  crtSyncZoomUI();
}
function crtSincronizarFrameUI() {
  document.getElementById('crtFrameLeft').value = crtFrameConfig.left;
  document.getElementById('crtFrameTop').value = crtFrameConfig.top;
  document.getElementById('crtFrameW').value = crtFrameConfig.width;
  document.getElementById('crtFrameH').value = crtFrameConfig.height;
  document.getElementById('crtFrameLeftVal').value = crtFrameConfig.left.toFixed(1);
  document.getElementById('crtFrameTopVal').value = crtFrameConfig.top.toFixed(1);
  document.getElementById('crtFrameWVal').value = crtFrameConfig.width.toFixed(1);
  document.getElementById('crtFrameHVal').value = crtFrameConfig.height.toFixed(1);
}
function crtAplicarCampoConfig(id) {
  var cfg = crtCamposConfig[id]; var el = document.getElementById(id);
  if (!el || !cfg) return;
  el.style.left = cfg.left + '%'; el.style.top = cfg.top + '%';
  el.style.fontSize = cfg.fontSize + 'mm'; el.style.color = cfg.color; el.style.fontWeight = cfg.fontWeight;
  if (cfg.text !== undefined && cfg.text !== null) el.textContent = cfg.text;
}
function crtAplicarTodosCampos() { for (var id in crtCamposConfig) crtAplicarCampoConfig(id); }
function crtSelecionarCampo(id) {
  var cfg = crtCamposConfig[id]; if (!cfg) return;
  document.getElementById('crtCampoX').value = cfg.left;
  document.getElementById('crtCampoY').value = cfg.top;
  document.getElementById('crtCampoSize').value = cfg.fontSize;
  document.getElementById('crtCampoCor').value = cfg.color;
  document.getElementById('crtCampoBold').value = cfg.fontWeight;
  document.getElementById('crtCampoXVal').value = cfg.left.toFixed(1);
  document.getElementById('crtCampoYVal').value = cfg.top.toFixed(1);
  document.getElementById('crtCampoSizeVal').value = cfg.fontSize.toFixed(1);
  document.getElementById('crtCampoCorVal').value = cfg.color;
  var isLabel = id.indexOf('Lbl') !== -1;
  var textoWrapper = document.getElementById('crtCampoTextoWrapper');
  if (isLabel) { textoWrapper.style.display = 'block'; document.getElementById('crtCampoTexto').value = cfg.text || ''; }
  else { textoWrapper.style.display = 'none'; }
  var overlays = document.querySelectorAll('.crt-overlay');
  for (var i = 0; i < overlays.length; i++) overlays[i].classList.toggle('crt-campo-hl', overlays[i].id === id);
}
function crtAtualizarCampo() {
  var id = document.getElementById('crtCampoSel').value;
  var cfg = crtCamposConfig[id]; if (!cfg) return;
  cfg.left = parseFloat(document.getElementById('crtCampoX').value);
  cfg.top = parseFloat(document.getElementById('crtCampoY').value);
  cfg.fontSize = parseFloat(document.getElementById('crtCampoSize').value);
  cfg.color = document.getElementById('crtCampoCor').value;
  cfg.fontWeight = parseInt(document.getElementById('crtCampoBold').value);
  if (id.indexOf('Lbl') !== -1) cfg.text = document.getElementById('crtCampoTexto').value;
  document.getElementById('crtCampoXVal').value = cfg.left.toFixed(1);
  document.getElementById('crtCampoYVal').value = cfg.top.toFixed(1);
  document.getElementById('crtCampoSizeVal').value = cfg.fontSize.toFixed(1);
  document.getElementById('crtCampoCorVal').value = cfg.color;
  crtAplicarCampoConfig(id);
}

async function crtSalvarLayout() {
  var btn = document.getElementById('crtBtnSalvar'); btn.disabled = true;
  var el = document.getElementById('crtMsgLayout'); el.innerHTML = '<span style="color:#2563eb">Salvando...</span>';
  var savedCampos = {};
  for (var localId in crtCamposConfig) { savedCampos[crtKeyMap[localId] || localId] = crtCamposConfig[localId]; }
  var configJson = JSON.stringify({ frame: crtFrameConfig, campos: savedCampos });
  try {
    var token = localStorage.getItem('token');
    var resp = await fetch('/api/carteirinhas/config', {
      method: 'PUT',
      headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
      body: JSON.stringify({ config: configJson })
    });
    var r = await resp.json();
    btn.disabled = false;
    if (r.erro) el.innerHTML = '<span style="color:#dc2626">' + r.erro + '</span>';
    else el.innerHTML = '<span style="color:#16a34a">Layout salvo com sucesso!</span>';
  } catch(e) { btn.disabled = false; el.innerHTML = '<span style="color:#dc2626">Erro: ' + e.message + '</span>'; }
}

async function crtSalvarTemplates() {
  var msg = document.getElementById('crtMsgTemplate');
  var fileFrente = document.getElementById('crtTemplateFrente').files[0];
  var fileVerso = document.getElementById('crtTemplateVerso').files[0];
  if (!fileFrente && !fileVerso) { msg.innerHTML = '<span style="color:#dc2626">Selecione ao menos um arquivo.</span>'; return; }
  msg.innerHTML = '<span style="color:#2563eb">Salvando...</span>';
  var token = localStorage.getItem('token');
  try {
    if (fileFrente) {
      var fd = new FormData();
      fd.append('lado', 'frente');
      fd.append('template', fileFrente);
      var resp = await fetch('/api/carteirinhas/template', { method: 'POST', headers: { 'Authorization': 'Bearer ' + token }, body: fd });
      var r = await resp.json();
      if (r.sucesso && r.path) { crtTemplateFrenteUrl = r.path; document.getElementById('crtBg').src = r.path + '?t=' + Date.now(); }
    }
    if (fileVerso) {
      var fd2 = new FormData();
      fd2.append('lado', 'verso');
      fd2.append('template', fileVerso);
      var resp2 = await fetch('/api/carteirinhas/template', { method: 'POST', headers: { 'Authorization': 'Bearer ' + token }, body: fd2 });
      var r2 = await resp2.json();
      if (r2.sucesso && r2.path) { crtTemplateVersoUrl = r2.path; document.getElementById('crtBgVerso').src = r2.path + '?t=' + Date.now(); }
    }
    msg.innerHTML = '<span style="color:#16a34a">Template(s) salvo(s)!</span>';
  } catch(e) { msg.innerHTML = '<span style="color:#dc2626">Erro: ' + e.message + '</span>'; }
}

async function crtExcluirTemplate(lado) {
  if (!confirm('Tem certeza que deseja excluir o template ' + lado + '?')) return;
  var msg = document.getElementById('crtMsgTemplate');
