# Configurações do Servidor
NODE_ENV=development
PORT=3000

# Banco de Dados PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/aspge?schema=public"

# JWT Secret (gerar uma chave forte)
JWT_SECRET=sua_chave_secreta_aqui_minimo_32_caracteres
JWT_EXPIRES_IN=24h

# Upload de Arquivos
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=5242880

# Logs
LOG_LEVEL=info
LOG_DIR=./logs

# Configurações de Email (opcional - para notificações)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# URL da Aplicação (para links no email)
APP_URL=http://localhost:3000
