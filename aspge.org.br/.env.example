# Configurações do Servidor
NODE_ENV=development
PORT=3000

# Banco de Dados PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/aspge?schema=public"

# JWT Secret (gerar uma chave forte)
JWT_SECRET=sua_chave_secreta_aqui_minimo_32_caracteres
JWT_EXPIRES_IN=24h

# Upload de Arquivos
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=5242880

# Logs
LOG_LEVEL=info
LOG_DIR=./logs

# Configurações de Email (opcional - para notificações)
# Se SMTP_HOST estiver vazio, envios são simulados via log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# CSRF — origens adicionais permitidas para mutações na API (csv).
# APP_URL e os domínios de produção já entram automaticamente.
# ALLOWED_ORIGINS=https://outro-dominio.com,https://app.exemplo.com

# URL da Aplicação (para links no email)
APP_URL=http://localhost:3000
